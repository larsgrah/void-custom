+#pragma once
+
+#include <glib.h>
+#include <openssl/evp.h>
+
+#include "tudor.h"
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (EVP_PKEY, EVP_PKEY_free)
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (EVP_PKEY_CTX, EVP_PKEY_CTX_free)
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (EVP_MD_CTX, EVP_MD_CTX_free)
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (EVP_CIPHER_CTX, EVP_CIPHER_CTX_free)
+
+typedef struct _TudorTls TudorTls;
+
+#define TUDOR_TLS_RECORD_HANDSHAKE 22
+#define TUDOR_TLS_RECORD_ALERT     21
+#define TUDOR_TLS_RECORD_APPDATA   23
+
+/* Pairing certificates */
+EVP_PKEY *tudor_cert_new_host_key (GError **error);
+gboolean  tudor_cert_make_host (EVP_PKEY    *host_key,
+                                guint8       cert[TUDOR_CERT_SIZE],
+                                GError     **error);
+gboolean  tudor_cert_verify_sensor (const guint8 cert[TUDOR_CERT_SIZE],
+                                    guint8       fw_major,
+                                    guint8       fw_minor,
+                                    gboolean     key_flag,
+                                    GError     **error);
+EVP_PKEY *tudor_cert_get_pubkey (const guint8 cert[TUDOR_CERT_SIZE],
+                                 GError     **error);
+
+/* Session */
+TudorTls *tudor_tls_new (EVP_PKEY    *host_key,
+                         const guint8 host_cert[TUDOR_CERT_SIZE],
+                         EVP_PKEY    *sensor_pubkey);
+void      tudor_tls_free (TudorTls *tls);
+
+GByteArray *tudor_tls_client_hello (TudorTls *tls);
+GByteArray *tudor_tls_handle_server_hello (TudorTls     *tls,
+                                           const guint8 *data,
+                                           gsize         len,
+                                           GError      **error);
+gboolean    tudor_tls_handle_server_finished (TudorTls     *tls,
+                                              const guint8 *data,
+                                              gsize         len,
+                                              GError      **error);
+gboolean    tudor_tls_is_established (TudorTls *tls);
+
+GByteArray *tudor_tls_wrap (TudorTls     *tls,
+                            const guint8 *data,
+                            gsize         len);
+GByteArray *tudor_tls_unwrap (TudorTls     *tls,
+                              const guint8 *data,
+                              gsize         len,
+                              GError      **error);
+GByteArray *tudor_tls_close_notify (TudorTls *tls);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (TudorTls, tudor_tls_free)
