+#define TUDOR_REQ_PROBE_READ  0x1a  /* in, one byte */
+#define TUDOR_REQ_CMD         0x16  /* out, command bytes */
+#define TUDOR_REQ_RESP        0x17  /* in, response bytes */
+#define TUDOR_REQ_TLS_STATE   0x14  /* in, two bytes, first one is 1 in a session */
+#define TUDOR_REQ_SESSION_END 0x1b  /* out, no data, sent before the closing alert */
+
+/* Commands the driver is allowed to send, see tudor_cmd_allowed() */
+#define TUDOR_CMD_GET_VERSION     0x01
