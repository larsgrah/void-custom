+#define TUDOR_DB2_TYPE_PAYLOAD    0x03
+
+#define TUDOR_DB2_ID_SIZE         16
+
+/* Status words (first two bytes of every response) that mean success */
+#define TUDOR_STATUS_OK           0x0000
+#define TUDOR_STATUS_OK_412       0x0412
+#define TUDOR_STATUS_OK_5CC       0x05cc
+
+/* Certificate in the Synaptics format, 400 bytes */
+#define TUDOR_CERT_SIZE           400
+
+typedef struct
+{
+  guint32 build;
+  guint8  fw_major;
+  guint8  fw_minor;
+  guint8  product_id;
+  guint8  flags1;
+  guint8  flags2;
+  guint8  provision_state;
+  guint8  id[6];
+} TudorVersion;
+
+/* Reply of TUDOR_CMD_DB2_GET_DB_INFO, field names from the vendor driver's log */
+typedef struct
+{
+  guint16 version_major;
+  guint16 version_minor;
+  guint32 pversion;
+  guint16 uop_len;
+  guint16 top_len;
+  guint16 pop_len;
