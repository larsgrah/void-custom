+
+/* Class */
+
+static void
+fpi_device_synaptics_tudor_init (FpiDeviceSynapticsTudor *self)
+{
+}
+
+static const FpIdEntry id_table[] = {
+  { .vid = 0x047d, .pid = 0x00f2, },   /* Kensington VeriMark DT */
+  { .vid = 0, .pid = 0, .driver_data = 0 },
+};
+
+static void
+fpi_device_synaptics_tudor_class_init (FpiDeviceSynapticsTudorClass *klass)
+{
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (klass);
+
+  dev_class->id = "synaptics_tudor";
+  dev_class->full_name = "Synaptics Tudor Fingerprint Sensor";
+  dev_class->type = FP_DEVICE_TYPE_USB;
+  dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+  dev_class->id_table = id_table;
+  /* FIXME: placeholder until enrolling is figured out */
+  dev_class->nr_enroll_stages = 1;
+  dev_class->temp_hot_seconds = -1;
+
+  dev_class->open = tudor_open;
+  dev_class->close = tudor_close;
+  dev_class->list = tudor_list;
+  dev_class->enroll = tudor_enroll;
+  dev_class->verify = tudor_verify;
+  dev_class->identify = tudor_identify;
+  dev_class->delete = tudor_delete;
+
+  /* Only what works, not what the stubs would claim */
+  dev_class->features = FP_DEVICE_FEATURE_STORAGE | FP_DEVICE_FEATURE_STORAGE_LIST;
+}
