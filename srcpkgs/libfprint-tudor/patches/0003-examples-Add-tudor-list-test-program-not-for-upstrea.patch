diff --git a/examples/meson.build b/examples/meson.build
index 250c055b..af80f808 100644
--- a/examples/meson.build
+++ b/examples/meson.build
@@ -18,6 +18,16 @@ foreach example: examples
     )
 endforeach
 
+if 'synaptics_tudor' in drivers
+    executable('tudor-list',
+        'tudor-list.c',
