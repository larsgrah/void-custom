+  fpi_ssm_start (fpi_ssm_new (device, id_run_state, ID_NUM_STATES), verify_done);
 }
 
 static void
 tudor_identify (FpDevice *device)
 {
-  /* FIXME: not implemented */
-  fpi_device_identify_complete (device,
-                                fpi_device_error_new (FP_DEVICE_ERROR_NOT_SUPPORTED));
+  fpi_ssm_start (fpi_ssm_new (device, id_run_state, ID_NUM_STATES), identify_done);
+}
+
+/* Delete */
+
+enum {
+  DEL_INFO,
+  DEL_CHECK,
+  DEL_DELETE,
+  DEL_NUM_STATES,
+};
+
+static void
+del_info_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  static const guint8 ones[TUDOR_DB2_ID_SIZE] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+                                                  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+  static const guint8 zeros[TUDOR_DB2_ID_SIZE] = { 0 };
+
+  /* The user the template belongs to comes after a few bytes of header */
+  if (self->reply->len < 18 + TUDOR_DB2_ID_SIZE)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                          "Object info reply too short"));
+      return;
+    }
+
+  memcpy (self->user_id, self->reply->data + 18, TUDOR_DB2_ID_SIZE);
+  fp_dbg ("template belongs to a user");
+  if (memcmp (self->user_id, ones, sizeof (ones)) == 0 ||
+      memcmp (self->user_id, zeros, sizeof (zeros)) == 0)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_NOT_FOUND,
+                                                          "Template not found"));
+      return;
+    }
+  fpi_ssm_next_state (ssm);
+}
+
+/* Before deleting make sure the user has this one template and nothing
+ * else, since the delete takes everything below the user with it */
+static void
+del_check_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  const guint8 *r = self->reply->data;
+
+  if (self->reply->len < 2 + TUDOR_DB2_ID_SIZE || get_u16le (r) != 1 ||
+      memcmp (r + 2, self->template_id, TUDOR_DB2_ID_SIZE) != 0)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                          "The user of the template has other templates, "
+                                                          "not deleting"));
+      return;
+    }
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+del_delete_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  fp_info ("deleted %u objects", self->reply->len >= 2 ? get_u16le (self->reply->data) : 0);
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+del_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+  guint8 cmd[5 + TUDOR_DB2_ID_SIZE] = { 0 };
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case DEL_INFO:
+      cmd[0] = TUDOR_CMD_DB2_OBJ_INFO;
+      cmd[1] = TUDOR_DB2_TYPE_TEMPLATE;
+      memcpy (cmd + 5, self->template_id, TUDOR_DB2_ID_SIZE);
+      tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, del_info_done);
+      break;
+
+    case DEL_CHECK:
+      cmd[0] = TUDOR_CMD_DB2_OBJ_LIST;
+      cmd[1] = TUDOR_DB2_TYPE_TEMPLATE;
+      memcpy (cmd + 5, self->user_id, TUDOR_DB2_ID_SIZE);
+      tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, del_check_done);
+      break;
+
+    case DEL_DELETE:
+      cmd[0] = TUDOR_CMD_DB2_OBJ_DELETE;
+      cmd[1] = TUDOR_DB2_TYPE_USER;
+      memcpy (cmd + 5, self->user_id, TUDOR_DB2_ID_SIZE);
+      tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, del_delete_done);
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+del_done (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  fpi_device_delete_complete (device, error);
 }
 
 static void
 tudor_delete (FpDevice *device)
 {
-  /* FIXME: not implemented */
-  fpi_device_delete_complete (device,
-                              fpi_device_error_new (FP_DEVICE_ERROR_NOT_SUPPORTED));
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+  FpPrint *print = NULL;
+
+  fpi_device_get_delete_data (device, &print);
+  if (!tudor_print_get_id (print, self->template_id))
+    {
+      fpi_device_delete_complete (device, fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                                                    "Print has no template id"));
+      return;
+    }
+  fpi_ssm_start (fpi_ssm_new (device, del_run_state, DEL_NUM_STATES), del_done);
 }
 
