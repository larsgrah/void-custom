+/* Events */
+
+static void
+put_u32le (guint8 *p, guint32 v)
+{
+  p[0] = v & 0xff;
+  p[1] = (v >> 8) & 0xff;
+  p[2] = (v >> 16) & 0xff;
+  p[3] = v >> 24;
+}
+
+static void
+tudor_continue (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  TudorDoneFunc after = self->after;
+
+  self->after = NULL;
+  if (after)
+    after (self, ssm);
+  else
+    fpi_ssm_next_state (ssm);
+}
+
+static void
+event_config_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  /* The last word of the reply is the number of the next event */
+  if (self->reply->len >= 64)
+    self->event_seq = get_u16le (self->reply->data + 62);
+  tudor_continue (self, ssm);
+}
+
+/* One mask for the event types, flag 4 turns events off */
+static void
+tudor_event_config (FpiDeviceSynapticsTudor *self,
+                    FpiSsm                  *ssm,
+                    guint32                  mask,
+                    guint32                  flag,
+                    TudorDoneFunc            after)
+{
+  guint8 cmd[37] = { TUDOR_CMD_EVENT_CONFIG };
+
+  put_u32le (cmd + 1, mask);
+  put_u32le (cmd + 17, mask);
+  put_u32le (cmd + 33, flag);
+  self->after = after;
+  tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, event_config_done);
+}
+
+static void
+event_read_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  const guint8 *r = self->reply->data;
+  gsize len = self->reply->len;
+  guint count = len >= 4 ? get_u32le (r) : 0;
+
+  /* Each event is a type, a number, a timestamp and flags */
+  for (guint i = 0; i < count && 4 + (i + 1) * TUDOR_EVENT_SIZE <= len; i++)
+    {
+      const guint8 *ev = r + 4 + i * TUDOR_EVENT_SIZE;
+      guint type = get_u16le (ev);
+
+      fp_dbg ("event type %u number %u flags 0x%08x", type, get_u16le (ev + 2),
+              get_u32le (ev + 8));
+      if (type < 32)
+        self->event_seen |= 1u << type;
+      if (type == TUDOR_EVENT_FRAME && (get_u32le (ev + 8) & TUDOR_EVENT_REJECT))
+        self->event_reject = TRUE;
+    }
+  tudor_continue (self, ssm);
+}
+
+static void
+tudor_event_read (FpiDeviceSynapticsTudor *self,
+                  FpiSsm                  *ssm,
+                  guint16                  seq,
+                  TudorDoneFunc            after)
+{
+  guint8 cmd[9] = { TUDOR_CMD_EVENT_READ, seq & 0xff, seq >> 8, 0x20, 0x00, 0x01, 0x00, 0x00, 0x00 };
+
+  self->event_seen = 0;
+  self->event_reject = FALSE;
+  self->after = after;
+  tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, event_read_done);
+}
+
+static void
+tudor_pin_cb (FpiUsbTransfer *transfer,
+              FpDevice       *device,
+              gpointer        user_data,
+              GError         *error)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  self->pin_timed_out = FALSE;
+  if (error)
+    {
+      if (self->pin_short &&
+          g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_TIMED_OUT))
+        {
+          g_error_free (error);
+          self->pin_timed_out = TRUE;
+          tudor_continue (self, transfer->ssm);
+          return;
+        }
+      tudor_xfer_fail (self, transfer->ssm, error);
+      return;
+    }
+
+  dbg_hex ("event notice", transfer->buffer, transfer->actual_length);
+  tudor_continue (self, transfer->ssm);
+}
+
+/* The sensor tells about events on the interrupt endpoint, with a short
+ * wait it gives up after a second */
+static void
+tudor_wait_event (FpiDeviceSynapticsTudor *self,
+                  FpiSsm                  *ssm,
+                  gboolean                 short_wait,
+                  TudorDoneFunc            after)
+{
+  FpiUsbTransfer *transfer = fpi_usb_transfer_new (FP_DEVICE (self));
+
+  self->after = after;
+  self->pin_short = short_wait;
+  fpi_usb_transfer_fill_interrupt (transfer, TUDOR_EP_EVENT, 8);
+  transfer->ssm = ssm;
+  fpi_usb_transfer_submit (transfer, short_wait ? TUDOR_PIN_SHORT_MS : 0,
+                           tudor_cancellable (self), tudor_pin_cb, NULL);
+}
+
+static void
+tudor_led (FpiDeviceSynapticsTudor *self, FpiSsm *ssm, const guint8 *pattern)
+{
+  tudor_send_cmd (self, ssm, pattern, 125, 4096, TUDOR_DECODE_CMD, NULL);
+}
+
+/* Capture, shared by enroll, verify and identify */
+
+enum {
+  CAP_PRE_CONFIG,
+  CAP_PRE_WAIT,
+  CAP_PRE_READ,
+  CAP_PRE_OFF,
+  CAP_UP_CONFIG,
+  CAP_UP_WAIT,
+  CAP_UP_READ,
+  CAP_UP_OFF,
+  CAP_LED_WAIT,
+  CAP_ACQ_CONFIG,
+  CAP_ACQ,
+  CAP_ACQ_WAIT,
+  CAP_ACQ_READ,
+  CAP_LED_OFF,
+  CAP_OFF,
+  CAP_FINISH,
+  CAP_NUM_STATES,
+};
+
+static void
+cap_pre_wait_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  /* Nothing pending means the finger is not down */
+  if (self->pin_timed_out)
+    fpi_ssm_jump_to_state (ssm, CAP_PRE_OFF);
+  else
+    fpi_ssm_next_state (ssm);
+}
+
+static void
+cap_pre_off_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  gboolean down = self->event_seen & (1u << TUDOR_EVENT_FINGER_DOWN);
+  gboolean up = self->event_seen & (1u << TUDOR_EVENT_FINGER_UP);
+
+  /* A finger from before has to be lifted first */
+  if (down && !up)
+    fpi_ssm_next_state (ssm);
+  else
+    fpi_ssm_jump_to_state (ssm, CAP_LED_WAIT);
+}
+
+static void
+cap_up_read_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  if (self->event_seen & (1u << TUDOR_EVENT_FINGER_UP))
+    fpi_ssm_next_state (ssm);
+  else
+    fpi_ssm_jump_to_state (ssm, CAP_UP_WAIT);
+}
+
+static void
+cap_acq_read_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  if (!(self->event_seen & (1u << TUDOR_EVENT_FRAME)))
+    {
+      fpi_ssm_jump_to_state (ssm, CAP_ACQ_WAIT);
+      return;
+    }
+  self->cap_rejected = self->event_reject;
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+cap_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case CAP_PRE_CONFIG:
+      self->event_seen = 0;
+      self->cap_rejected = FALSE;
+      tudor_event_config (self, ssm, (1u << TUDOR_EVENT_FINGER_DOWN) | (1u << TUDOR_EVENT_FINGER_UP),
+                          0, NULL);
+      break;
+
+    case CAP_PRE_WAIT:
+      tudor_wait_event (self, ssm, TRUE, cap_pre_wait_done);
+      break;
+
+    case CAP_PRE_READ:
+      tudor_event_read (self, ssm, self->event_seq, NULL);
+      break;
+
+    case CAP_PRE_OFF:
+      tudor_event_config (self, ssm, 0, 4, cap_pre_off_done);
+      break;
+
+    case CAP_UP_CONFIG:
+      tudor_event_config (self, ssm, 1u << TUDOR_EVENT_FINGER_UP, 0, NULL);
+      break;
+
+    case CAP_UP_WAIT:
+      tudor_wait_event (self, ssm, FALSE, NULL);
+      break;
+
+    case CAP_UP_READ:
+      tudor_event_read (self, ssm, self->event_seq, cap_up_read_done);
+      break;
+
+    case CAP_UP_OFF:
+      tudor_event_config (self, ssm, 0, 4, NULL);
+      break;
+
+    case CAP_LED_WAIT:
+      tudor_led (self, ssm, led_wait);
+      break;
+
+    case CAP_ACQ_CONFIG:
+      tudor_event_config (self, ssm, 1u << TUDOR_EVENT_FRAME, 0, NULL);
+      break;
+
+    case CAP_ACQ:
+      {
+        const guint8 cmd[17] = {
+          TUDOR_CMD_FRAME_ACQ, self->acq_arg, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 8, 1, 1, 1, 0
+        };
+
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    case CAP_ACQ_WAIT:
+      tudor_wait_event (self, ssm, FALSE, NULL);
+      break;
+
+    case CAP_ACQ_READ:
+      tudor_event_read (self, ssm, 0, cap_acq_read_done);
+      break;
+
+    case CAP_LED_OFF:
+      tudor_led (self, ssm, led_off);
+      break;
+
+    case CAP_OFF:
+      tudor_event_config (self, ssm, 0, 4, NULL);
+      break;
+
+    case CAP_FINISH:
+      {
+        static const guint8 cmd[] = { TUDOR_CMD_FRAME_FINISH };
+
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+tudor_start_capture (FpiDeviceSynapticsTudor *self, FpiSsm *parent, guint8 acq_arg)
+{
+  self->acq_arg = acq_arg;
+  fpi_ssm_start_subsm (parent, fpi_ssm_new (FP_DEVICE (self), cap_run_state, CAP_NUM_STATES));
+}
+
+/* Cleanup after a failed or cancelled operation, errors in here do not matter */
+
+enum {
+  CLEAN_OFF,
+  CLEAN_LED,
+  CLEAN_FINISH,
+  CLEAN_ENROLL_END,
+  CLEAN_NUM_STATES,
+};
+
+static void
+clean_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case CLEAN_OFF:
+      tudor_event_config (self, ssm, 0, 4, NULL);
+      break;
+
+    case CLEAN_LED:
+      tudor_led (self, ssm, led_off);
+      break;
+
+    case CLEAN_FINISH:
+      {
+        static const guint8 cmd[] = { TUDOR_CMD_FRAME_FINISH };
+
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    case CLEAN_ENROLL_END:
+      {
+        static const guint8 cmd[] = { TUDOR_CMD_ENROLL, TUDOR_ENROLL_END, 0, 0, 0 };
+
+        if (!self->enroll_begun)
+          {
+            fpi_ssm_mark_completed (ssm);
+            return;
+          }
+        self->enroll_begun = FALSE;
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+clean_done (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+  GError *op_error = g_steal_pointer (&self->op_error);
+  TudorFinishFunc finish = self->finish;
+
+  g_clear_error (&error);
+  self->cleanup = FALSE;
+  self->finish = NULL;
+  finish (self, op_error);
+}
+
+/* Passes the error on to finish once the sensor is back in a sane state */
+static void
+tudor_finish_op (FpiDeviceSynapticsTudor *self, GError *error, TudorFinishFunc finish)
+{
+  /* A retry is not an error, the capture has already put things away */
+  if ((!error && !self->enroll_begun) || (error && error->domain == FP_DEVICE_RETRY))
+    {
+      finish (self, error);
+      return;
+    }
+
+  self->op_error = error;
+  self->cleanup = TRUE;
+  self->finish = finish;
+  fpi_ssm_start (fpi_ssm_new (FP_DEVICE (self), clean_run_state, CLEAN_NUM_STATES), clean_done);
+}
+
+/* Enroll */
+
+enum {
+  EN_BEGIN,
+  EN_CAPTURE,
+  EN_PROCESS,
+  EN_LED,
+  EN_COMMIT,
+  EN_END,
+  EN_NUM_STATES,
+};
+
+static guint8
+tudor_subfactor (FpFinger finger)
+{
+  /* Left hand 6 to 10 and right hand 1 to 5 in Windows, the other way here */
+  if (finger >= FP_FINGER_LEFT_THUMB && finger <= FP_FINGER_LEFT_LITTLE)
+    return finger + 5;
+  if (finger >= FP_FINGER_RIGHT_THUMB && finger <= FP_FINGER_RIGHT_LITTLE)
+    return finger - 5;
+  return 0;
+}
+
+static void
+put_tlv (GByteArray *out, guint16 type, const guint8 *data, guint32 len)
+{
+  guint8 head[6] = { type & 0xff, type >> 8 };
+
+  put_u32le (head + 2, len);
+  g_byte_array_append (out, head, sizeof (head));
+  g_byte_array_append (out, data, len);
+}
+
+/* The command that stores the enrollment: a list of type, length, data
+ * with the template id, an identity (type 2 is a guid, a new one for each
+ * print so every print is a user of its own), the finger and a payload
+ * that is the user id string. */
+static GByteArray *
+tudor_build_commit (FpiDeviceSynapticsTudor *self, FpPrint *print)
+{
+  g_autofree gchar *user_id = fpi_print_generate_user_id (print);
+  g_autoptr(GByteArray) blob = g_byte_array_new ();
+  GByteArray *cmd = g_byte_array_new ();
+  guint8 identity[76] = { 2 };
+  guint8 subfactor = tudor_subfactor (fp_print_get_finger (print));
+  guint8 head[13] = { TUDOR_CMD_ENROLL, TUDOR_ENROLL_COMMIT };
+
+  for (guint i = 0; i < 16; i++)
+    identity[4 + i] = g_random_int_range (0, 256);
+
+  put_tlv (blob, 0, self->template_id, TUDOR_DB2_ID_SIZE);
+  put_tlv (blob, 1, identity, sizeof (identity));
+  put_tlv (blob, 2, &subfactor, 1);
+  put_tlv (blob, 3, (const guint8 *) user_id, MIN (strlen (user_id), TUDOR_PAYLOAD_MAX));
+
+  /* Seven zero bytes, then the length of the list */
+  put_u32le (head + 9, blob->len);
+  g_byte_array_append (cmd, head, sizeof (head));
+  g_byte_array_append (cmd, blob->data, blob->len);
+  return cmd;
+}
+
+static void
+en_add_done (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  const guint8 *r = self->reply->data;
+  FpDevice *device = FP_DEVICE (self);
+  guint stages;
+  gboolean done = FALSE;
+
+  if (self->reply->len < 24)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                          "Enroll reply too short"));
+      return;
+    }
+
+  /* Template id once done, then a mask of the captures taken and percent done */
+  for (guint i = 0; i < TUDOR_DB2_ID_SIZE; i++)
+    done |= r[i] != 0;
+  stages = __builtin_popcount (get_u16le (r + 20));
+  fp_dbg ("enroll %u captures, %u percent%s", stages, get_u16le (r + 22), done ? ", done" : "");
+
+  self->enroll_stages = stages;
+  fpi_device_enroll_progress (device, MIN (stages, TUDOR_ENROLL_STAGES), NULL, NULL);
+
+  if (done)
+    {
+      memcpy (self->template_id, r, TUDOR_DB2_ID_SIZE);
+      fpi_ssm_next_state (ssm);
+    }
+  else
+    {
+      fpi_ssm_jump_to_state (ssm, EN_CAPTURE);
+    }
+}
+
+static void
+en_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case EN_BEGIN:
+      {
+        static const guint8 cmd[13] = { TUDOR_CMD_ENROLL, TUDOR_ENROLL_BEGIN };
+
+        self->enroll_begun = TRUE;
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    case EN_CAPTURE:
+      tudor_start_capture (self, ssm, 0x0c);
+      break;
+
+    case EN_PROCESS:
+      {
+        static const guint8 cmd[5] = { TUDOR_CMD_ENROLL, TUDOR_ENROLL_ADD };
+
+        if (self->cap_rejected)
+          {
+            fpi_device_enroll_progress (device, MIN (self->enroll_stages, TUDOR_ENROLL_STAGES), NULL,
+                                        fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+            fpi_ssm_jump_to_state (ssm, EN_CAPTURE);
+            return;
+          }
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, en_add_done);
+      }
+      break;
+
+    case EN_LED:
+      tudor_led (self, ssm, led_ok);
+      break;
+
+    case EN_COMMIT:
+      {
+        FpPrint *print;
+        g_autoptr(GByteArray) cmd = NULL;
+
+        fpi_device_get_enroll_data (device, &print);
+        cmd = tudor_build_commit (self, print);
+        tudor_send_cmd (self, ssm, cmd->data, cmd->len, 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    case EN_END:
+      {
+        static const guint8 cmd[5] = { TUDOR_CMD_ENROLL, TUDOR_ENROLL_END };
+
+        self->enroll_begun = FALSE;
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD, NULL);
+      }
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+enroll_finish (FpiDeviceSynapticsTudor *self, GError *error)
+{
+  FpDevice *device = FP_DEVICE (self);
+  FpPrint *print = NULL;
+
+  if (error)
+    {
+      fpi_device_enroll_complete (device, NULL, error);
+      return;
+    }
+
+  fpi_device_get_enroll_data (device, &print);
+  fpi_device_enroll_complete (device, g_object_ref (tudor_print_new (self, print, self->template_id)),
+                              NULL);
+}
+
+static void
+en_done (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  tudor_finish_op (FPI_DEVICE_SYNAPTICS_TUDOR (device), error, enroll_finish);
+}
 
