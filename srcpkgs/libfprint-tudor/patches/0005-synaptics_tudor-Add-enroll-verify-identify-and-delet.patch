+++ b/examples/tudor-test.c
@@ -0,0 +1,169 @@
+/*
+ * Hardware test for the synaptics_tudor driver. Enrolls a print of its own,
+ * verifies and identifies it and deletes it again. Nothing else on the
+ * sensor is ever deleted, only the print made in this run. Needs a finger
+ * that is not enrolled on the sensor already.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <libfprint/fprint.h>
+
+static void
+say (const char *what)
+{
+  g_print ("%s\n", what);
+  fflush (stdout);
+}
+
+static void
+enroll_progress (FpDevice *dev, gint done, FpPrint *print, gpointer data, GError *error)
+{
+  if (error)
+    g_print ("  retry: %s\n", error->message);
+  else
+    g_print ("  enroll stage %d done\n", done);
+  fflush (stdout);
+}
+
+static void
+match_cb (FpDevice *dev, FpPrint *match, FpPrint *print, gpointer data, GError *error)
+{
+  g_print ("  match callback: %s\n", error ? error->message : (match ? "match" : "no match"));
+  fflush (stdout);
+}
+
+static guint
+count_prints (FpDevice *dev)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GPtrArray) prints = fp_device_list_prints_sync (dev, NULL, &error);
+
+  if (!prints)
+    {
+      g_printerr ("  list failed: %s\n", error->message);
+      return G_MAXUINT;
+    }
+  g_print ("  %u prints on the sensor\n", prints->len);
+  for (guint i = 0; i < prints->len; i++)
+    g_print ("    %s\n", fp_print_get_description (g_ptr_array_index (prints, i)));
+  fflush (stdout);
+  return prints->len;
+}
+
+int
+main (void)
+{
+  g_autoptr(FpContext) ctx = fp_context_new ();
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) template = NULL;
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new ();
+  FpDevice *dev = NULL;
+  GPtrArray *devices = fp_context_get_devices (ctx);
+  FpPrint *match = NULL;
+  gboolean ok = FALSE;
+  guint before, after;
+  gboolean matched = FALSE;
+
+  for (guint i = 0; devices && i < devices->len; i++)
+    {
+      FpDevice *d = g_ptr_array_index (devices, i);
+
+      if (g_strcmp0 (fp_device_get_driver (d), "synaptics_tudor") == 0)
+        dev = d;
+    }
+  if (!dev)
+    {
+      g_printerr ("No synaptics_tudor device found\n");
+      return 1;
+    }
+
+  if (!fp_device_open_sync (dev, NULL, &error))
+    {
+      g_printerr ("Open failed: %s\n", error->message);
+      return 1;
+    }
+
+  say ("before:");
+  before = count_prints (dev);
+
+  say ("ENROLL: touch with the finger and lift it, repeat until it is done");
+  template = fp_print_new (dev);
+  fp_print_set_finger (template, FP_FINGER_RIGHT_THUMB);
+  fp_print_set_username (template, "tudor-test");
+  print = fp_device_enroll_sync (dev, g_object_ref (template), NULL, enroll_progress, NULL, &error);
+  if (!print)
+    {
+      g_printerr ("Enroll failed: %s\n", error->message);
+      goto out;
+    }
+  say ("enrolled");
+
+  say ("after enroll:");
+  after = count_prints (dev);
+  if (before != G_MAXUINT && after != before + 1)
+    g_printerr ("Expected one more print, not going on to delete\n");
+
+  for (int tries = 0; tries < 5 && !matched; tries++)
+    {
+      g_clear_error (&error);
+      say ("VERIFY: touch once");
+      if (fp_device_verify_sync (dev, print, NULL, match_cb, NULL, &matched, NULL, &error))
+        g_print ("  verify result: %s\n", matched ? "match" : "no match");
+      else if (!g_error_matches (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL) &&
+               error->domain != FP_DEVICE_RETRY)
+        break;
+    }
+
+  g_ptr_array_add (gallery, print);
+  for (int tries = 0; tries < 5; tries++)
+    {
+      g_clear_error (&error);
+      say ("IDENTIFY: touch once");
+      if (fp_device_identify_sync (dev, gallery, NULL, match_cb, NULL, &match, NULL, &error))
+        {
+          g_print ("  identify result: %s\n", match ? "found the print" : "no match");
+          break;
+        }
+      if (error->domain != FP_DEVICE_RETRY)
+        break;
+    }
+  g_clear_error (&error);
+
+  ok = TRUE;
+
+out:
+  if (print && after == before + 1)
+    {
+      say ("DELETE the print made in this run");
+      if (!fp_device_delete_print_sync (dev, print, NULL, &error))
+        {
+          g_printerr ("Delete failed: %s\n", error->message);
+          g_clear_error (&error);
+          ok = FALSE;
+        }
+      say ("after delete:");
+      count_prints (dev);
+    }
+
+  if (!fp_device_close_sync (dev, NULL, &error))
+    {
+      g_printerr ("Close failed: %s\n", error->message);
+      return 1;
+    }
+  return ok ? 0 : 1;
+}
