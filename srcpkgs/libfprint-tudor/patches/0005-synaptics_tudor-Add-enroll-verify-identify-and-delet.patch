+  self->enroll_stages = 0;
+  self->enroll_begun = FALSE;
+  fpi_ssm_start (fpi_ssm_new (device, en_run_state, EN_NUM_STATES), en_done);
+}
+
+/* Verify and identify */
+
+enum {
+  ID_CAPTURE,
+  ID_PROCESS,
+  ID_LED,
+  ID_NUM_STATES,
+};
+
+static void
+id_done_cmd (FpiDeviceSynapticsTudor *self, FpiSsm *ssm)
+{
+  if (self->status == TUDOR_STATUS_OK && self->reply->len >= TUDOR_DB2_ID_SIZE)
+    {
+      self->matched = TRUE;
+      memcpy (self->template_id, self->reply->data, TUDOR_DB2_ID_SIZE);
+    }
+  else if (self->status == TUDOR_STATUS_NO_MATCH)
+    {
+      self->matched = FALSE;
+    }
+  else
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                          "Identify failed with status 0x%04x",
+                                                          self->status));
+      return;
+    }
+  fpi_ssm_next_state (ssm);
+}
+
+static void
+id_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case ID_CAPTURE:
+      self->matched = FALSE;
+      tudor_start_capture (self, ssm, 0x14);
+      break;
+
+    case ID_PROCESS:
+      {
+        static const guint8 cmd[13] = { TUDOR_CMD_IDENTIFY, 0x01 };
+
+        if (self->cap_rejected)
+          {
+            self->op_error = fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+            fpi_ssm_mark_completed (ssm);
+            return;
+          }
+        tudor_send_cmd (self, ssm, cmd, sizeof (cmd), 4096, TUDOR_DECODE_CMD_ANY_STATUS,
+                        id_done_cmd);
+      }
+      break;
+
+    case ID_LED:
+      tudor_led (self, ssm, self->matched ? led_ok : led_fail);
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+verify_finish (FpiDeviceSynapticsTudor *self, GError *error)
+{
+  FpDevice *device = FP_DEVICE (self);
+  FpPrint *print = NULL;
+  guint8 id[TUDOR_DB2_ID_SIZE];
+
+  if (error && error->domain == FP_DEVICE_RETRY)
+    {
+      fpi_device_verify_report (device, FPI_MATCH_ERROR, NULL, error);
+      fpi_device_verify_complete (device, NULL);
+      return;
+    }
+  if (error)
+    {
+      fpi_device_verify_complete (device, error);
+      return;
+    }
+
+  fpi_device_get_verify_data (device, &print);
+  if (self->matched && tudor_print_get_id (print, id) &&
+      memcmp (id, self->template_id, sizeof (id)) == 0)
+    fpi_device_verify_report (device, FPI_MATCH_SUCCESS, NULL, NULL);
+  else
+    fpi_device_verify_report (device, FPI_MATCH_FAIL, NULL, NULL);
+  fpi_device_verify_complete (device, NULL);
+}
+
+static void
+identify_finish (FpiDeviceSynapticsTudor *self, GError *error)
+{
+  FpDevice *device = FP_DEVICE (self);
+  GPtrArray *gallery = NULL;
+  FpPrint *match = NULL;
+
+  if (error && error->domain == FP_DEVICE_RETRY)
+    {
+      fpi_device_identify_report (device, NULL, NULL, error);
+      fpi_device_identify_complete (device, NULL);
+      return;
+    }
+  if (error)
+    {
+      fpi_device_identify_complete (device, error);
+      return;
+    }
+
+  fpi_device_get_identify_data (device, &gallery);
+  for (guint i = 0; self->matched && i < gallery->len; i++)
+    {
+      FpPrint *candidate = g_ptr_array_index (gallery, i);
+      guint8 id[TUDOR_DB2_ID_SIZE];
+
+      if (tudor_print_get_id (candidate, id) &&
+          memcmp (id, self->template_id, sizeof (id)) == 0)
+        {
+          match = candidate;
+          break;
+        }
+    }
+
+  fpi_device_identify_report (device, match, NULL, NULL);
+  fpi_device_identify_complete (device, NULL);
+}
+
+static void
+verify_done (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  if (!error)
+    error = g_steal_pointer (&self->op_error);
+  tudor_finish_op (self, error, verify_finish);
+}
+
+static void
+identify_done (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  FpiDeviceSynapticsTudor *self = FPI_DEVICE_SYNAPTICS_TUDOR (device);
+
+  if (!error)
+    error = g_steal_pointer (&self->op_error);
+  tudor_finish_op (self, error, identify_finish);
 }
 
