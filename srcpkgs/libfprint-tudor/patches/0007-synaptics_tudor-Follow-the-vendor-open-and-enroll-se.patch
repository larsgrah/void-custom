--- /dev/null
+++ b/examples/tudor-delete.c
@@ -0,0 +1,74 @@
+/*
+ * Deletes prints from a Synaptics Tudor sensor by description, the
+ * tudor-template-XXXXXXXX names tudor-list prints. Only the ones named on
+ * the command line, nothing else. Not for upstream.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <libfprint/fprint.h>
+
+int
+main (int argc, char **argv)
+{
+  g_autoptr(FpContext) ctx = fp_context_new ();
+  g_autoptr(GError) error = NULL;
+  GPtrArray *devices;
+  FpDevice *dev;
+  g_autoptr(GPtrArray) prints = NULL;
+  int deleted = 0;
+
+  if (argc < 2)
+    {
+      fprintf (stderr, "usage: %s tudor-template-XXXXXXXX...\n", argv[0]);
+      return 2;
+    }
+
+  devices = fp_context_get_devices (ctx);
+  if (!devices || devices->len == 0)
+    {
+      fprintf (stderr, "no device\n");
+      return 1;
+    }
+  dev = g_ptr_array_index (devices, 0);
+
+  if (!fp_device_open_sync (dev, NULL, &error))
+    {
+      fprintf (stderr, "open: %s\n", error->message);
+      return 1;
+    }
+
+  prints = fp_device_list_prints_sync (dev, NULL, &error);
+  if (!prints)
+    {
+      fprintf (stderr, "list: %s\n", error->message);
+      fp_device_close_sync (dev, NULL, NULL);
+      return 1;
+    }
+
+  for (guint i = 0; i < prints->len; i++)
+    {
+      FpPrint *print = g_ptr_array_index (prints, i);
+      const char *name = fp_print_get_description (print);
+
+      for (int a = 1; a < argc; a++)
+        {
+          if (!name || strcmp (name, argv[a]) != 0)
+            continue;
+          if (fp_device_delete_print_sync (dev, print, NULL, &error))
+            {
+              printf ("deleted %s\n", name);
+              deleted++;
+            }
+          else
+            {
+              printf ("could not delete %s: %s\n", name, error->message);
+              g_clear_error (&error);
+            }
+        }
+    }
+
+  fp_device_close_sync (dev, NULL, NULL);
+  printf ("%d deleted\n", deleted);
+  return 0;
+}
diff --git a/examples/tudor-match.c b/examples/tudor-match.c
new file mode 100644
index 00000000..24246ce5
--- /dev/null
+++ b/examples/tudor-match.c
@@ -0,0 +1,48 @@
+/*
+ * Identify against the prints listed from the sensor, for debugging a
+ * no-match. Run with G_MESSAGES_DEBUG=all. Not for upstream.
+ */
+
+#include <stdio.h>
+#include <libfprint/fprint.h>
+
+int
+main (void)
+{
+  g_autoptr(FpContext) ctx = fp_context_new ();
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GPtrArray) prints = NULL;
+  g_autoptr(FpPrint) match = NULL;
+  GPtrArray *devices;
+  FpDevice *dev;
+
+  devices = fp_context_get_devices (ctx);
+  if (!devices || devices->len == 0)
+    return 1;
+  dev = g_ptr_array_index (devices, 0);
+
+  if (!fp_device_open_sync (dev, NULL, &error))
+    {
+      fprintf (stderr, "open: %s\n", error->message);
+      return 1;
+    }
+
+  prints = fp_device_list_prints_sync (dev, NULL, &error);
+  if (!prints)
+    {
+      fprintf (stderr, "list: %s\n", error->message);
+      return 1;
+    }
+  for (guint i = 0; i < prints->len; i++)
+    printf ("gallery: %s\n", fp_print_get_description (g_ptr_array_index (prints, i)));
+
+  printf ("IDENTIFY: touch once\n");
+  fflush (stdout);
+  if (!fp_device_identify_sync (dev, prints, NULL, NULL, NULL, &match, NULL, &error))
+    printf ("identify error: %s\n", error->message);
+  else
+    printf ("identify result: %s\n", match ? fp_print_get_description (match) : "no match");
+
+  fp_device_close_sync (dev, NULL, NULL);
+  return 0;
+}
