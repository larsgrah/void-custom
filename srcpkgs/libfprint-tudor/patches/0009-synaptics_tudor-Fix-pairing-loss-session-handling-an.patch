+/* Database */
+
+/* Where the print metadata goes. The sensor keeps what the commit command
+ * gave it, with the identity as the first 76 bytes. Those start with a type
+ * word, 2 for a guid, then the 16 byte guid (all the vendor driver puts
+ * there) and 56 more bytes that are free. The user id string of libfprint
+ * is kept in them, zero terminated. */
+#define TUDOR_IDENTITY_SIZE   76
+#define TUDOR_IDENTITY_GUID   2
+#define TUDOR_IDENTITY_TEXT   20
+#define TUDOR_IDENTITY_TEXT_MAX (TUDOR_IDENTITY_SIZE - TUDOR_IDENTITY_TEXT)
+
+/* Types of the entries in the commit command and in the object data */
+#define TUDOR_TLV_TEMPLATE    0
+#define TUDOR_TLV_IDENTITY    1
+#define TUDOR_TLV_SUBFACTOR   2
+#define TUDOR_TLV_PAYLOAD     3
+
+/* Windows numbers the right hand 1 to 5 and the left 6 to 10, libfprint the
+ * other way round. Swapping them is its own inverse. */
+static guint8
+tudor_subfactor (FpFinger finger)
+{
+  if (finger >= FP_FINGER_LEFT_THUMB && finger <= FP_FINGER_LEFT_LITTLE)
+    return finger + 5;
+  if (finger >= FP_FINGER_RIGHT_THUMB && finger <= FP_FINGER_RIGHT_LITTLE)
+    return finger - 5;
+  return 0;
+}
+
+typedef struct
+{
+  FpFinger finger;
+  gchar   *user_id;
+} TudorPayloadInfo;
+
+static void
+tudor_payload_info_clear (TudorPayloadInfo *info)
+{
+  g_clear_pointer (&info->user_id, g_free);
+}
+
+/* Reply of the object data read for a payload: a reserved word, the length
+ * and then the same list of entries the commit command had. */
+static gboolean
+tudor_parse_payload (const guint8      *data,
+                     gsize              len,
+                     TudorPayloadInfo  *info)
+{
+  guint32 total;
+  gsize off = 6;
+
+  info->finger = FP_FINGER_UNKNOWN;
+  info->user_id = NULL;
+
+  if (len < off)
+    return FALSE;
+  total = tudor_get_u32le (data + 2);
+  if (total > len - off)
+    return FALSE;
+  len = off + total;
 
-  if (!tudor_key_export (self->host_key, secret, &error))
+  while (len - off >= 6)
     {
-      fp_warn ("could not store pairing: %s", error->message);
-      return;
+      guint16 type = tudor_get_u16le (data + off);
+      guint32 size = tudor_get_u32le (data + off + 2);
+      const guint8 *body = data + off + 6;
+
+      if (size > len - off - 6)
+        return FALSE;
+
+      if (type == TUDOR_TLV_SUBFACTOR && size == 1)
+        {
+          FpFinger finger = tudor_subfactor (body[0]);
+
+          if (finger != FP_FINGER_UNKNOWN)
+            info->finger = finger;
+        }
+      else if (type == TUDOR_TLV_IDENTITY && size >= TUDOR_IDENTITY_SIZE &&
+               tudor_get_u32le (body) == TUDOR_IDENTITY_GUID)
+        {
+          const guint8 *text = body + TUDOR_IDENTITY_TEXT;
+          gsize text_len = strnlen ((const char *) text, TUDOR_IDENTITY_TEXT_MAX);
+
+          if (text_len < TUDOR_IDENTITY_TEXT_MAX && g_str_has_prefix ((const char *) text, "FP1-"))
