+
+static gboolean
+tudor_print_get_id (FpPrint *print,
+                    guint8   id[TUDOR_DB2_ID_SIZE])
+{
+  g_autoptr(GVariant) data = NULL;
+  g_autoptr(GVariant) bytes = NULL;
+  gsize n = 0;
+  gconstpointer p;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(ay)")))
+    return FALSE;
+
+  bytes = g_variant_get_child_value (data, 0);
+  p = g_variant_get_fixed_array (bytes, &n, 1);
+  if (n != TUDOR_DB2_ID_SIZE)
+    return FALSE;
+  memcpy (id, p, n);
+  return TRUE;
+}
