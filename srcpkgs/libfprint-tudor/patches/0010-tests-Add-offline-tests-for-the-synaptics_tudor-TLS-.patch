index 00000000..7f8b8378
--- /dev/null
+++ b/examples/tudor-session.c
@@ -0,0 +1,452 @@
+/*
+ * Hardware session for the synaptics_tudor driver (not for upstream).
+ *
+ * Without options it only reads: inventory, a delete of an id that does not
+ * exist, a cancelled identify and the finger status flags that go with it.
+ * With --finger-tests it also enrolls a print of its own with a test finger,
+ * lists, verifies and identifies it and deletes it again. Prints that were on
+ * the sensor before the run are never deleted, only the one made in the run.
+ * --abandon-enroll starts an enroll and dies, to see the next one recover.
+ * Copyright (C) 2026 Lars Grahmann <lars.grahmann@googlemail.com>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <signal.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <libfprint/fprint.h>
+
+static FpDevice *dev;
+static guint failures;
+static guint stage_calls;
+static GCancellable *enroll_cancel;
+static guint cancel_after_stage;
+static GString *seen_status;
+
+static void say (const char *fmt,
+                 ...) G_GNUC_PRINTF (1, 2);
+
+static void
+say (const char *fmt, ...)
+{
+  va_list ap;
+
+  va_start (ap, fmt);
+  vprintf (fmt, ap);
+  va_end (ap);
+  printf ("\n");
+  fflush (stdout);
+}
+
+static void
+check (gboolean    ok,
+       const char *what)
+{
+  say ("  [%s] %s", ok ? "ok" : "FAIL", what);
+  if (!ok)
+    failures++;
+}
+
+static const char *
+finger_status_string (FpFingerStatusFlags f)
+{
+  switch ((int) f)
+    {
+    case FP_FINGER_STATUS_NONE:
+      return "none";
+
+    case FP_FINGER_STATUS_NEEDED:
+      return "needed";
+
+    case FP_FINGER_STATUS_PRESENT:
+      return "present";
+
+    case FP_FINGER_STATUS_NEEDED | FP_FINGER_STATUS_PRESENT:
+      return "needed+present";
+
+    default:
+      return "?";
+    }
+}
+
+static void
+status_cb (FpDevice   *d,
+           GParamSpec *pspec,
+           gpointer    data)
+{
+  const char *name = finger_status_string (fp_device_get_finger_status (d));
+
+  say ("  finger status: %s", name);
+  g_string_append_printf (seen_status, "%s ", name);
+}
+
+static gchar *
+print_id (FpPrint *print)
+{
+  g_autoptr(GVariant) data = NULL;
+  g_autoptr(GVariant) bytes = NULL;
+  gsize n = 0;
+  const guint8 *p;
+  GString *s = g_string_new (NULL);
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data)
+    return g_string_free (s, FALSE);
+  bytes = g_variant_get_child_value (data, 0);
+  p = g_variant_get_fixed_array (bytes, &n, 1);
+  for (gsize i = 0; i < n; i++)
+    g_string_append_printf (s, "%02x", p[i]);
+  return g_string_free (s, FALSE);
+}
+
+static GPtrArray *
+list_prints (const char *title)
+{
+  g_autoptr(GError) error = NULL;
+  GPtrArray *prints = fp_device_list_prints_sync (dev, NULL, &error);
+
+  if (!prints)
+    {
+      say ("  list failed: %s", error->message);
+      failures++;
+      return NULL;
+    }
+  say ("%s: %u prints", title, prints->len);
+  for (guint i = 0; i < prints->len; i++)
+    {
+      FpPrint *p = g_ptr_array_index (prints, i);
+      g_autofree gchar *id = print_id (p);
+
+      say ("    %s finger %d user %s id %.8s", fp_print_get_description (p),
+           fp_print_get_finger (p), fp_print_get_username (p) ? fp_print_get_username (p) : "-", id);
+    }
+  return prints;
+}
+
+static gboolean
+cancel_cb (gpointer data)
+{
+  g_cancellable_cancel (data);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+die_cb (gpointer data)
+{
+  raise (SIGKILL);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+in_list (GPtrArray  *prints,
+         const char *id)
+{
+  for (guint i = 0; prints && i < prints->len; i++)
+    {
+      g_autofree gchar *other = print_id (g_ptr_array_index (prints, i));
+
+      if (g_strcmp0 (other, id) == 0)
+        return TRUE;
+    }
+  return FALSE;
+}
+
+static void
+enroll_progress (FpDevice *d,
+                 gint      done,
+                 FpPrint  *print,
+                 gpointer  data,
+                 GError   *error)
+{
+  if (error)
+    {
+      say ("  retry: %s", error->message);
+      return;
+    }
+
+  say ("  enroll stage %d done", done);
+  stage_calls++;
+  if (cancel_after_stage && stage_calls >= cancel_after_stage && enroll_cancel)
+    g_cancellable_cancel (enroll_cancel);
+}
+
+static void
+match_cb (FpDevice *d,
+          FpPrint  *match,
+          FpPrint  *print,
+          gpointer  data,
+          GError   *error)
+{
+  if (error)
+    say ("  report: %s", error->message);
+}
+
+/* Part A: nothing here changes the sensor */
+static void
+read_only_part (GPtrArray **inventory)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) fake = fp_print_new (dev);
+  g_autoptr(GCancellable) cancel = g_cancellable_new ();
+  g_autoptr(GPtrArray) gallery = NULL;
+  g_autoptr(GPtrArray) again = NULL;
+  FpPrint *match = NULL;
+  guint8 id[16];
+
+  say ("A1 inventory");
+  *inventory = list_prints ("on the sensor");
+  check (*inventory != NULL, "list works");
+
+  say ("A2 delete of an id that is not there");
+  for (int i = 0; i < 16; i++)
+    id[i] = 0xa0 + i;
+  g_object_set (fake, "fpi-type", 1,
+                "fpi-data", g_variant_new ("(@ay)", g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, id, 16, 1)),
+                NULL);
+  check (!fp_device_delete_print_sync (dev, fake, NULL, &error) &&
+         g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_NOT_FOUND),
+         "error is DATA_NOT_FOUND");
+  g_clear_error (&error);
+
+  say ("A3 identify that is cancelled while it waits for a finger (do not touch)");
+  gallery = *inventory ? g_ptr_array_ref (*inventory) : g_ptr_array_new ();
+  g_string_truncate (seen_status, 0);
+  g_timeout_add (2000, cancel_cb, cancel);
+  check (!fp_device_identify_sync (dev, gallery, cancel, match_cb, NULL, &match, NULL, &error) &&
+         g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED),
+         "identify ends with CANCELLED");
+  if (error)
+    say ("  error was: %s", error->message);
+  g_clear_error (&error);
+  check (strstr (seen_status->str, "needed") != NULL, "finger status said needed while waiting");
+  check (fp_device_get_finger_status (dev) == FP_FINGER_STATUS_NONE, "finger status is none again");
+
+  say ("A4 the session still works after the cancel");
+  again = list_prints ("on the sensor");
+  check (again != NULL && *inventory && again->len == (*inventory)->len, "same prints as before");
+}
+
+/* Part B needs the owner */
+static void
+finger_part (GPtrArray *inventory)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) template = NULL;
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GPtrArray) after = NULL;
+  g_autoptr(GPtrArray) gallery = NULL;
+  g_autofree gchar *new_id = NULL;
+  FpPrint *match = NULL;
+  FpPrint *listed = NULL;
+  gboolean matched = FALSE;
+  gboolean deleted = FALSE;
+
+  say ("B1 the test finger must not be enrolled already");
+  say (">>> TOUCH ONCE with the TEST finger (left index)");
+  if (fp_device_identify_sync (dev, inventory, NULL, match_cb, NULL, &match, NULL, &error) && match)
+    {
+      check (FALSE, "the test finger matched an enrolled print, pick another finger");
+      return;
+    }
+  if (error)
+    say ("  identify said: %s", error->message);
+  check (TRUE, "test finger is not enrolled");
+  g_clear_error (&error);
+
+  say ("B2 enroll that is cancelled after two stages");
+  say (">>> TOUCH TWICE with the TEST finger (left index), lifting in between, then stop");
+  template = fp_print_new (dev);
+  fp_print_set_finger (template, FP_FINGER_LEFT_INDEX);
+  fp_print_set_username (template, "tudor-test");
+  enroll_cancel = g_cancellable_new ();
+  cancel_after_stage = 2;
+  stage_calls = 0;
+  print = fp_device_enroll_sync (dev, g_object_ref (template), enroll_cancel, enroll_progress, NULL, &error);
+  check (print == NULL && g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED),
+         "enroll ends with CANCELLED");
+  if (error)
+    say ("  error was: %s", error->message);
+  g_clear_error (&error);
+  g_clear_object (&enroll_cancel);
+  cancel_after_stage = 0;
+  after = list_prints ("after the cancelled enroll");
+  check (after && inventory && after->len == inventory->len, "nothing was stored");
+  g_clear_pointer (&after, g_ptr_array_unref);
+
+  say ("B3 the real enroll");
+  say (">>> TOUCH the TEST finger (left index), lift, repeat until it says enrolled");
+  g_string_truncate (seen_status, 0);
+  print = fp_device_enroll_sync (dev, g_object_ref (template), NULL, enroll_progress, NULL, &error);
+  if (!print)
+    {
+      say ("  enroll failed: %s", error->message);
+      check (FALSE, "enroll");
+      return;
+    }
+  check (TRUE, "enroll finished");
+  check (strstr (seen_status->str, "needed") != NULL && strstr (seen_status->str, "present") != NULL,
+         "finger status went through needed and present");
+  check (fp_device_get_finger_status (dev) == FP_FINGER_STATUS_NONE, "finger status none at the end");
+  say ("  description of the new print: %s", fp_print_get_description (print));
+  new_id = print_id (print);
+
+  say ("B4 list shows the new print with its metadata");
+  after = list_prints ("on the sensor");
+  check (after && inventory && after->len == inventory->len + 1, "one more print");
+  for (guint i = 0; after && i < after->len; i++)
+    {
+      FpPrint *p = g_ptr_array_index (after, i);
+      g_autofree gchar *id = print_id (p);
+
+      if (g_strcmp0 (id, new_id) == 0)
+        listed = p;
+    }
+  if (listed)
+    {
+      check (g_strcmp0 (fp_print_get_username (listed), "tudor-test") == 0, "username survived");
+      check (fp_print_get_finger (listed) == FP_FINGER_LEFT_INDEX, "finger survived");
+      check (fp_print_get_enroll_date (listed) != NULL, "enroll date present");
+      check (fp_print_equal (listed, print), "listed print equals the enrolled one");
+    }
+  else
+    {
+      check (FALSE, "new print is in the list");
+    }
+
+  say ("B5 verify with the test finger");
+  say (">>> TOUCH ONCE with the TEST finger (left index)");
+  matched = FALSE;
+  if (fp_device_verify_sync (dev, print, NULL, match_cb, NULL, &matched, NULL, &error))
+    check (matched, "verify matches");
+  else
+    check (FALSE, error->message);
+  g_clear_error (&error);
+
+  say ("B6 verify with another finger that is enrolled");
+  say (">>> TOUCH ONCE with your USUAL finger (one that was enrolled before)");
+  matched = TRUE;
+  if (fp_device_verify_sync (dev, print, NULL, match_cb, NULL, &matched, NULL, &error))
+    check (!matched, "no match for the test print");
+  else
+    say ("  verify said: %s (retry, not counted)", error->message);
+  g_clear_error (&error);
+
+  say ("B7 identify with the listed prints");
+  say (">>> TOUCH ONCE with the TEST finger (left index)");
+  gallery = after ? g_ptr_array_ref (after) : g_ptr_array_new ();
+  match = NULL;
+  if (fp_device_identify_sync (dev, gallery, NULL, match_cb, NULL, &match, NULL, &error))
+    {
+      g_autofree gchar *mid = match ? print_id (match) : NULL;
+
+      check (match != NULL && g_strcmp0 (mid, new_id) == 0, "identify finds the test print");
+    }
+  else
+    {
+      check (FALSE, error->message);
+    }
+  g_clear_error (&error);
+
+  say ("B8 a very short tap, only for the log (what does a rejected touch look like)");
+  say (">>> TAP the TEST finger (left index) as briefly as you can, once");
+  if (!fp_device_verify_sync (dev, print, NULL, match_cb, NULL, &matched, NULL, &error))
+    say ("  result: %s%s", error->message, error->domain == FP_DEVICE_RETRY ? " (retry)" : "");
+  else
+    say ("  result: %s", matched ? "match" : "no match");
+  g_clear_error (&error);
+
+  say ("B9 delete the test print, this also cleans up deleted slots");
+  if (fp_device_delete_print_sync (dev, print, NULL, &error))
+    {
+      deleted = TRUE;
+      check (TRUE, "delete worked");
+    }
+  else
+    {
+      check (FALSE, error->message);
+    }
+  g_clear_error (&error);
+  g_clear_pointer (&after, g_ptr_array_unref);
+  after = list_prints ("on the sensor after the delete");
+  check (deleted && after && inventory && after->len == inventory->len, "back to the prints from before");
+  for (guint i = 0; inventory && i < inventory->len; i++)
+    {
+      g_autofree gchar *id = print_id (g_ptr_array_index (inventory, i));
+
+      check (in_list (after, id), "an earlier print is still there");
+    }
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr(FpContext) ctx = fp_context_new ();
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GPtrArray) inventory = NULL;
+  GPtrArray *devices = fp_context_get_devices (ctx);
+  gboolean finger_tests = FALSE, abandon = FALSE;
+
+  for (int i = 1; i < argc; i++)
+    {
+      finger_tests |= g_strcmp0 (argv[i], "--finger-tests") == 0;
+      abandon |= g_strcmp0 (argv[i], "--abandon-enroll") == 0;
+    }
+
+  for (guint i = 0; devices && i < devices->len; i++)
+    {
+      FpDevice *d = g_ptr_array_index (devices, i);
+
+      if (g_strcmp0 (fp_device_get_driver (d), "synaptics_tudor") == 0)
+        dev = d;
+    }
+  if (!dev)
+    {
+      g_printerr ("No synaptics_tudor device found\n");
+      return 1;
+    }
+
+  seen_status = g_string_new (NULL);
+  if (!fp_device_open_sync (dev, NULL, &error))
+    {
+      g_printerr ("Open failed: %s\n", error->message);
+      return 1;
+    }
+  g_signal_connect (dev, "notify::finger-status", G_CALLBACK (status_cb), NULL);
+
+  if (abandon)
+    {
+      g_autoptr(FpPrint) template = fp_print_new (dev);
+
+      say ("starting an enroll and dying after two seconds");
+      fp_print_set_finger (template, FP_FINGER_LEFT_INDEX);
+      g_timeout_add (2000, die_cb, NULL);
+      fp_device_enroll_sync (dev, template, NULL, enroll_progress, NULL, &error);
+      return 1;
+    }
+
+  read_only_part (&inventory);
+  if (finger_tests)
+    finger_part (inventory);
+
+  if (!fp_device_close_sync (dev, NULL, &error))
+    {
+      say ("close failed: %s", error->message);
+      failures++;
+    }
+  say ("%s: %u check(s) failed", failures ? "FAILED" : "PASSED", failures);
+  return failures ? 1 : 0;
+}
