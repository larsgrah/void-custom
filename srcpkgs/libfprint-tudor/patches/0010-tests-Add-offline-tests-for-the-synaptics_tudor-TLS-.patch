+static void
+test_record (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GByteArray) pt = NULL;
+  g_autoptr(GByteArray) sealed = g_byte_array_new ();
+  guint8 tampered[sizeof (vec_rec_sealed_seq5)];
+
+  /* Decrypt a record the python side made */
+  pt = gcm_open (vec_rec_key, vec_rec_salt, 5, TLS_APPDATA,
+                 vec_rec_sealed_seq5 + 5, sizeof (vec_rec_sealed_seq5) - 5, &error);
+  g_assert_no_error (error);
+  assert_bytes (pt->data, pt->len, vec_rec_plain);
+  g_clear_pointer (&pt, g_byte_array_unref);
+
+  /* The explicit nonce is whatever the record carries */
+  pt = gcm_open (vec_rec_key, vec_rec_salt, 6, TLS_APPDATA,
+                 vec_rec_sealed_seq6_other_nonce + 5,
+                 sizeof (vec_rec_sealed_seq6_other_nonce) - 5, &error);
+  g_assert_no_error (error);
+  assert_bytes (pt->data, pt->len, vec_rec_plain);
+  g_clear_pointer (&pt, g_byte_array_unref);
+
+  /* Sequence number, record type and every single byte are authenticated */
+  g_assert_null (gcm_open (vec_rec_key, vec_rec_salt, 6, TLS_APPDATA,
+                           vec_rec_sealed_seq5 + 5, sizeof (vec_rec_sealed_seq5) - 5, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_clear_error (&error);
+  g_assert_null (gcm_open (vec_rec_key, vec_rec_salt, 5, TLS_ALERT,
+                           vec_rec_sealed_seq5 + 5, sizeof (vec_rec_sealed_seq5) - 5, &error));
+  g_clear_error (&error);
+  for (gsize i = 5; i < sizeof (tampered); i++)
+    {
+      memcpy (tampered, vec_rec_sealed_seq5, sizeof (tampered));
+      tampered[i] ^= 0x40;
+      g_assert_null (gcm_open (vec_rec_key, vec_rec_salt, 5, TLS_APPDATA,
+                               tampered + 5, sizeof (tampered) - 5, &error));
+      g_clear_error (&error);
+    }
+
+  /* Too short to hold a nonce and a tag */
+  g_assert_null (gcm_open (vec_rec_key, vec_rec_salt, 5, TLS_APPDATA,
+                           vec_rec_sealed_seq5 + 5, 23, &error));
+  g_clear_error (&error);
+
+  /* Sealing with the seeded stream gives the python bytes */
+  tudor_tls_set_seed (SEED);
+  g_assert_true (gcm_seal (vec_rec_key, vec_rec_salt, 5, TLS_APPDATA,
+                           vec_rec_plain, sizeof (vec_rec_plain), sealed));
+  tudor_tls_set_seed (NULL);
+  g_assert_cmpmem (sealed->data, sealed->len, vec_rec_sealed_seq5 + 5,
+                   sizeof (vec_rec_sealed_seq5) - 5);
+}
+
+static void
+test_sig_fixed (void)
+{
+  static const struct
+  {
+    const guint8 *der;
+    gsize         der_len;
+    const guint8 *fixed;
+  } cases[VEC_SIG_CASES] = {
+    { vec_sig0_der, sizeof (vec_sig0_der), vec_sig0_fixed },
+    { vec_sig1_der, sizeof (vec_sig1_der), vec_sig1_fixed },
+    { vec_sig2_der, sizeof (vec_sig2_der), vec_sig2_fixed },
+    { vec_sig3_der, sizeof (vec_sig3_der), vec_sig3_fixed },
+    { vec_sig4_der, sizeof (vec_sig4_der), vec_sig4_fixed },
+  };
+  guint8 out[70];
+
+  for (guint i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+      memset (out, 0xee, sizeof (out));
+      g_assert_true (sig_to_fixed (cases[i].der, cases[i].der_len, out));
+      g_assert_cmpmem (out, sizeof (out), cases[i].fixed, 70);
+    }
+
+  g_assert_false (sig_to_fixed (vec_sig0_der, 3, out));
+  g_assert_false (sig_to_fixed (vec_prf_seed, 20, out));
+}
+
+static TudorTls *
+new_tls (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(EVP_PKEY) host = tudor_key_import (vec_host_secret, &error);
+  g_autoptr(EVP_PKEY) sensor = tudor_cert_get_pubkey (vec_pair_reply + 2 + TUDOR_CERT_SIZE, &error);
+  TudorTls *tls;
+
+  g_assert_no_error (error);
+  tls = tudor_tls_new (host, vec_host_cert, sensor);
+  g_assert_nonnull (tls);
+  return tls;
+}
+
+/* The state of the session once the handshake is through */
+static TudorTls *
+established_tls (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GByteArray) hello = NULL;
+  g_autoptr(GByteArray) flight = NULL;
+  TudorTls *tls = new_tls ();
+  gboolean rejected;
+
+  tudor_tls_set_seed (SEED);
+  hello = tudor_tls_client_hello (tls, &error);
+  g_assert_no_error (error);
+  flight = tudor_tls_handle_server_hello (tls, vec_server_flight, sizeof (vec_server_flight), &error);
+  g_assert_no_error (error);
+  g_assert_true (tudor_tls_handle_server_finished (tls, vec_server_finished,
+                                                   sizeof (vec_server_finished),
+                                                   &rejected, &error));
+  g_assert_no_error (error);
+  return tls;
+}
+
+static void
+test_handshake (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GByteArray) hello = NULL;
+  g_autoptr(GByteArray) flight = NULL;
+  g_autoptr(GByteArray) wrapped = NULL;
+  g_autoptr(GByteArray) plain = NULL;
+  g_autoptr(GByteArray) bye = NULL;
+  TudorTls *tls = new_tls ();
+  gboolean rejected = TRUE;
+
+  tudor_tls_set_seed (SEED);
+
+  hello = tudor_tls_client_hello (tls, &error);
+  g_assert_no_error (error);
+  assert_bytes (hello->data, hello->len, vec_client_hello);
+
+  /* The real server hello, certificate request and done go in, the whole
+   * client flight comes out: certificate, key exchange, certificate
+   * verify, change cipher spec and the encrypted finished */
+  flight = tudor_tls_handle_server_hello (tls, vec_server_flight, sizeof (vec_server_flight), &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (flight);
+  assert_bytes (flight->data, flight->len, vec_flight);
+  g_assert_false (tudor_tls_is_established (tls));
+
+  /* The master secret and key block are what python derived */
+  g_assert_cmpmem (tls->c_key, 32, vec_keyblock, 32);
+  g_assert_cmpmem (tls->s_key, 32, vec_keyblock + 32, 32);
+  g_assert_cmpmem (tls->c_salt, 4, vec_keyblock + 64, 4);
+  g_assert_cmpmem (tls->s_salt, 4, vec_keyblock + 68, 4);
+
+  g_assert_true (tudor_tls_handle_server_finished (tls, vec_server_finished,
+                                                   sizeof (vec_server_finished),
+                                                   &rejected, &error));
+  g_assert_no_error (error);
+  g_assert_false (rejected);
+  g_assert_true (tudor_tls_is_established (tls));
+
+  /* Both directions count from 0 at the finished */
+  wrapped = tudor_tls_wrap (tls, vec_app_cmd, sizeof (vec_app_cmd));
+  assert_bytes (wrapped->data, wrapped->len, vec_app_sent);
+
+  plain = tudor_tls_unwrap (tls, vec_app_recv_seq1, sizeof (vec_app_recv_seq1), &error);
+  g_assert_no_error (error);
+  assert_bytes (plain->data, plain->len, vec_app_reply);
+
+  /* The same record again is the wrong sequence number */
+  g_assert_null (tudor_tls_unwrap (tls, vec_app_recv_seq1, sizeof (vec_app_recv_seq1), &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_clear_error (&error);
+
+  g_clear_pointer (&plain, g_byte_array_unref);
+  plain = tudor_tls_unwrap (tls, vec_app_recv_seq2, sizeof (vec_app_recv_seq2), &error);
+  g_assert_no_error (error);
+  assert_bytes (plain->data, plain->len, vec_app_reply);
+
+  bye = tudor_tls_close_notify (tls);
+  assert_bytes (bye->data, bye->len, vec_close_notify);
+
+  tudor_tls_set_seed (NULL);
+  tudor_tls_free (tls);
+}
+
+static void
+test_unwrap_errors (void)
+{
+  g_autoptr(GError) error = NULL;
+  TudorTls *tls = established_tls ();
+  guint8 bad[sizeof (vec_app_recv_seq1) + 3];
+  guint8 two[2 * sizeof (vec_app_recv_seq1)];
+  GByteArray *ok;
+
+  tudor_tls_set_seed (NULL);
+
+  /* A record from the future does not move the counter */
+  g_assert_null (tudor_tls_unwrap (tls, vec_app_recv_seq2, sizeof (vec_app_recv_seq2), &error));
+  g_clear_error (&error);
+
+  /* Flipped bits */
+  memcpy (bad, vec_app_recv_seq1, sizeof (vec_app_recv_seq1));
+  bad[sizeof (vec_app_recv_seq1) - 1] ^= 1;
+  g_assert_null (tudor_tls_unwrap (tls, bad, sizeof (vec_app_recv_seq1), &error));
+  g_clear_error (&error);
+
+  /* Truncated */
+  for (gsize i = 0; i < sizeof (vec_app_recv_seq1); i++)
+    {
+      g_assert_null (tudor_tls_unwrap (tls, vec_app_recv_seq1, i, &error));
+      g_clear_error (&error);
+    }
+
+  /* Two records in one reply */
+  memcpy (two, vec_app_recv_seq1, sizeof (vec_app_recv_seq1));
+  memcpy (two + sizeof (vec_app_recv_seq1), vec_app_recv_seq1, sizeof (vec_app_recv_seq1));
+  g_assert_null (tudor_tls_unwrap (tls, two, sizeof (two), &error));
+  g_clear_error (&error);
+
+  /* Wrong record type */
+  memcpy (bad, vec_app_recv_seq1, sizeof (vec_app_recv_seq1));
+  bad[0] = TLS_HANDSHAKE;
+  g_assert_null (tudor_tls_unwrap (tls, bad, sizeof (vec_app_recv_seq1), &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_clear_error (&error);
+
+  /* After all that the real record still decrypts, nothing moved */
+  ok = tudor_tls_unwrap (tls, vec_app_recv_seq1, sizeof (vec_app_recv_seq1), &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (ok);
+  g_byte_array_unref (ok);
+
+  /* An alert from the sensor is an error with its description */
+  g_assert_null (tudor_tls_unwrap (tls, vec_server_alert, sizeof (vec_server_alert), &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_assert_nonnull (strstr (error->message, "description 40"));
+  g_clear_error (&error);
+
+  tudor_tls_free (tls);
+}
+
+static void
+test_rejection (void)
+{
+  static const guint8 handshake_failure[] = { 0x15, 3, 3, 0, 2, 2, 40 };
+  static const guint8 unknown_ca[] = { 0x15, 3, 3, 0, 2, 2, 48 };
+  static const guint8 bad_record_mac[] = { 0x15, 3, 3, 0, 2, 2, 20 };
+  static const guint8 warning[] = { 0x15, 3, 3, 0, 2, 1, 40 };
+  static const guint8 garbage[] = { 0x15, 3, 3, 0, 9, 1, 2, 3 };
+  static const struct
+  {
+    const guint8 *data;
+    gsize         len;
+    gboolean      rejected;
+  } cases[] = {
+    { handshake_failure, sizeof (handshake_failure), TRUE },
+    { unknown_ca, sizeof (unknown_ca), TRUE },
+    { bad_record_mac, sizeof (bad_record_mac), FALSE },
+    { warning, sizeof (warning), FALSE },
+    { garbage, sizeof (garbage), FALSE },
+    { vec_server_alert, sizeof (vec_server_alert), FALSE },
+  };
+
+  /* Only a plain fatal alert about the certificate counts as a rejection of
+   * the pairing, a broken reply never does */
+  for (guint i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+      g_autoptr(GError) error = NULL;
+      g_autoptr(GByteArray) hello = NULL;
+      g_autoptr(GByteArray) flight = NULL;
+      TudorTls *tls = new_tls ();
+      gboolean rejected = !cases[i].rejected;
+
+      tudor_tls_set_seed (SEED);
+      hello = tudor_tls_client_hello (tls, &error);
+      flight = tudor_tls_handle_server_hello (tls, vec_server_flight, sizeof (vec_server_flight), &error);
+      g_assert_no_error (error);
+      tudor_tls_set_seed (NULL);
+
+      g_assert_false (tudor_tls_handle_server_finished (tls, cases[i].data, cases[i].len,
+                                                        &rejected, &error));
+      g_assert_nonnull (error);
+      g_assert_cmpint (rejected, ==, cases[i].rejected);
+      g_assert_false (tudor_tls_is_established (tls));
+      tudor_tls_free (tls);
+    }
+
+  /* A truncated finished */
+  for (gsize i = 0; i < sizeof (vec_server_finished); i++)
+    {
+      g_autoptr(GError) error = NULL;
+      g_autoptr(GByteArray) flight = NULL;
+      TudorTls *tls = new_tls ();
+      gboolean rejected = TRUE;
+
+      tudor_tls_set_seed (SEED);
+      g_byte_array_unref (tudor_tls_client_hello (tls, &error));
+      flight = tudor_tls_handle_server_hello (tls, vec_server_flight, sizeof (vec_server_flight), &error);
+      tudor_tls_set_seed (NULL);
+      g_assert_false (tudor_tls_handle_server_finished (tls, vec_server_finished, i,
+                                                        &rejected, &error));
+      g_assert_false (rejected);
+      tudor_tls_free (tls);
+    }
+}
+
+static void
+test_malformed_hello (void)
+{
+  guint8 bad[sizeof (vec_server_flight)];
+
+  /* Every cut of the real flight and flipped bytes in it must end in an
+   * error or a flight, never in a crash */
+  for (gsize i = 0; i < sizeof (vec_server_flight); i++)
+    {
+      g_autoptr(GError) error = NULL;
+      g_autoptr(GByteArray) flight = NULL;
+      TudorTls *tls = new_tls ();
+
+      tudor_tls_set_seed (SEED);
+      g_byte_array_unref (tudor_tls_client_hello (tls, &error));
+      flight = tudor_tls_handle_server_hello (tls, vec_server_flight, i, &error);
+      g_assert_null (flight);
+      g_assert_nonnull (error);
+      tudor_tls_free (tls);
+    }
+
+  for (gsize i = 0; i < sizeof (vec_server_flight); i++)
+    {
+      g_autoptr(GError) error = NULL;
+      g_autoptr(GByteArray) flight = NULL;
+      TudorTls *tls = new_tls ();
+
+      memcpy (bad, vec_server_flight, sizeof (bad));
+      bad[i] ^= 0xff;
+      tudor_tls_set_seed (SEED);
+      g_byte_array_unref (tudor_tls_client_hello (tls, &error));
+      flight = tudor_tls_handle_server_hello (tls, bad, sizeof (bad), &error);
+      tudor_tls_free (tls);
+    }
+
+  /* Without a hello there is nothing to answer */
+  {
+    g_autoptr(GError) error = NULL;
+    TudorTls *tls = new_tls ();
+
+    g_assert_null (tudor_tls_handle_server_hello (tls, vec_server_flight,
+                                                  sizeof (vec_server_flight), &error));
+    g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+    tudor_tls_free (tls);
+  }
+  tudor_tls_set_seed (NULL);
+}
+
+static void
+test_pairing_file (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(EVP_PKEY) host = tudor_key_import (vec_host_secret, &error);
+  g_autoptr(EVP_PKEY) back = NULL;
+  guint8 data[TUDOR_PAIRING_SIZE];
+  guint8 host_cert[TUDOR_CERT_SIZE];
+  guint8 dev_cert[TUDOR_CERT_SIZE];
+  guint8 secret[32];
+
+  g_assert_true (tudor_pairing_encode (host, vec_host_cert, vec_pair_reply + 2 + TUDOR_CERT_SIZE,
+                                       data, &error));
+  g_assert_no_error (error);
+  g_assert_cmpmem (data, 10, "TUDORPAIR1", 10);
+  g_assert_cmpmem (data + 10, 32, vec_host_secret, 32);
+
+  back = tudor_pairing_decode (data, sizeof (data), host_cert, dev_cert, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (back);
+  g_assert_true (tudor_key_export (back, secret, &error));
+  assert_bytes (secret, sizeof (secret), vec_host_secret);
+  assert_bytes (host_cert, sizeof (host_cert), vec_host_cert);
+  g_assert_cmpmem (dev_cert, sizeof (dev_cert), vec_pair_reply + 2 + TUDOR_CERT_SIZE,
+                   TUDOR_CERT_SIZE);
+  g_clear_pointer (&back, EVP_PKEY_free);
+
+  /* Truncated at every length and with too much */
+  for (gsize i = 0; i < sizeof (data); i++)
+    {
+      g_assert_null (tudor_pairing_decode (data, i, host_cert, dev_cert, &error));
+      g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID);
+      g_clear_error (&error);
+    }
+  {
+    g_autofree guint8 *big = g_malloc0 (sizeof (data) + 1);
+
+    memcpy (big, data, sizeof (data));
+    g_assert_null (tudor_pairing_decode (big, sizeof (data) + 1, host_cert, dev_cert, &error));
+    g_clear_error (&error);
+  }
+
+  /* Corrupt magic */
+  data[3] ^= 1;
+  g_assert_null (tudor_pairing_decode (data, sizeof (data), host_cert, dev_cert, &error));
+  g_clear_error (&error);
+  data[3] ^= 1;
+
+  /* A key that is not on the curve is refused, not crashed on */
+  memset (data + 10, 0xff, 32);
+  back = tudor_pairing_decode (data, sizeof (data), host_cert, dev_cert, &error);
+  g_assert_null (back);
+  g_clear_error (&error);
+  memset (data + 10, 0, 32);
+  back = tudor_pairing_decode (data, sizeof (data), host_cert, dev_cert, &error);
+  g_assert_null (back);
+  g_clear_error (&error);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/tudor-tls/stream", test_stream);
+  g_test_add_func ("/tudor-tls/prf", test_prf);
+  g_test_add_func ("/tudor-tls/cert", test_cert);
+  g_test_add_func ("/tudor-tls/record", test_record);
+  g_test_add_func ("/tudor-tls/sig-fixed", test_sig_fixed);
+  g_test_add_func ("/tudor-tls/handshake", test_handshake);
+  g_test_add_func ("/tudor-tls/unwrap-errors", test_unwrap_errors);
+  g_test_add_func ("/tudor-tls/rejection", test_rejection);
+  g_test_add_func ("/tudor-tls/malformed-hello", test_malformed_hello);
+  g_test_add_func ("/tudor-tls/pairing-file", test_pairing_file);
+
+  return g_test_run ();
+}
diff --git a/tests/tudor-tls-vectors.py b/tests/tudor-tls-vectors.py
new file mode 100644
index 00000000..a2d137bb
--- /dev/null
+++ b/tests/tudor-tls-vectors.py
@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+# Dev script, not run by the build. Writes test-tudor-tls-vectors.h, the
+# expected bytes for test-tudor-tls.c, computed with python-cryptography and
+# hmac only, so they are independent of the C code. The server side bytes
+# are real ones from a trace of the vendor driver talking to a sensor, the
+# client side uses fixed keys and the seeded random stream of the driver.
+#
+#   tudor-tls-vectors.py PAIR_REPLY.bin SERVER_HELLO_FLIGHT.bin > test-tudor-tls-vectors.h
+#
+# PAIR_REPLY.bin is the data stage of the pairing reply (status, host cert,
+# sensor cert), SERVER_HELLO_FLIGHT.bin the record the sensor answers the
+# client hello with.
+
+import hashlib
+import hmac
+import sys
+
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.asymmetric.utils import encode_dss_signature
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
+SEED = b"tudor emulation seed, not secret"
+HS_SECRET = bytes.fromhex("717cd72d0962bc4a2846138dbb2c2419")
+HS_SEED = bytes.fromhex("2512a76407065f383846139d4bec2033aaaa")
+
+
+def prf(h, secret, label, seed, n):
+    seed = label + seed
+    a = seed
+    out = b""
+    while len(out) < n:
+        a = hmac.new(secret, a, h).digest()
+        out += hmac.new(secret, a + seed, h).digest()
+    return out[:n]
+
+
+class Stream:
+    def __init__(self, seed):
+        self.seed, self.n = seed, 0
+
+    def take(self, n):
+        out = b""
+        while len(out) < n:
+            out += hashlib.sha256(self.seed + self.n.to_bytes(8, "big")).digest()[:min(32, n - len(out))]
+            self.n += 1
+        return out
+
+
+def k_for(d, h1):
+    x = d.to_bytes(32, "big")
+    h = (int.from_bytes(h1, "big") % N).to_bytes(32, "big")
+    v, k = b"\x01" * 32, b"\x00" * 32
+    k = hmac.new(k, v + b"\x00" + x + h, hashlib.sha256).digest()
+    v = hmac.new(k, v, hashlib.sha256).digest()
+    k = hmac.new(k, v + b"\x01" + x + h, hashlib.sha256).digest()
+    v = hmac.new(k, v, hashlib.sha256).digest()
+    while True:
+        v = hmac.new(k, v, hashlib.sha256).digest()
+        c = int.from_bytes(v, "big")
+        if 1 <= c < N:
+            return c
+        k = hmac.new(k, v + b"\x00", hashlib.sha256).digest()
+        v = hmac.new(k, v, hashlib.sha256).digest()
+
+
+def sign(d, h1):
+    k = k_for(d, h1)
+    r = ec.derive_private_key(k, ec.SECP256R1()).public_key().public_numbers().x % N
+    s = pow(k, -1, N) * (int.from_bytes(h1, "big") % N + r * d) % N
+    return r, s
+
+
+def pub(d):
+    return ec.derive_private_key(d, ec.SECP256R1()).public_key().public_numbers()
+
+
+def be(n):
+    return n.to_bytes(32, "big")
+
+
+def u24(n):
+    return n.to_bytes(3, "big")
+
+
+def record(t, body):
+    return bytes([t, 3, 3]) + len(body).to_bytes(2, "big") + body
+
+
+def hs(t, body):
+    return bytes([t]) + u24(len(body)) + body
+
+
+def seal(key, salt, seq, t, pt, nonce):
+    aad = seq.to_bytes(8, "big") + bytes([t, 3, 3]) + len(pt).to_bytes(2, "big")
+    return nonce + AESGCM(key).encrypt(salt + nonce, pt, aad)
+
+
+def cert(host_d, hs_d):
+    p = pub(host_d)
+    c = bytearray(400)
+    c[0:2] = bytes.fromhex("3f5f")
+    c[2:4] = (23).to_bytes(2, "little")
+    c[4:36] = be(p.x)[::-1]
+    c[72:104] = be(p.y)[::-1]
+    c[141] = 0
+    h1 = hashlib.sha256(bytes(c[:142])).digest()
+    r, s = sign(hs_d, h1)
+    der = encode_dss_signature(r, s)
+    c[142:144] = len(der).to_bytes(2, "little")
+    c[144:144 + len(der)] = der
+    return bytes(c)
+
+
+out = []
+
+
+def arr(name, data):
+    lines = []
+    for i in range(0, len(data), 12):
+        lines.append("  " + ", ".join("0x%02x" % b for b in data[i:i + 12]))
+    out.append("static const guint8 %s[] = {\n%s\n};\n" % (name, ",\n".join(lines)))
+
+
+pair = open(sys.argv[1], "rb").read()
+sh_record = open(sys.argv[2], "rb").read()
+assert len(pair) == 802 and sh_record[0] == 22
+
+host_d = int.from_bytes(hashlib.sha256(b"tudor test host key").digest(), "big") % N
+hs_d = int.from_bytes(prf(hashlib.sha256, HS_SECRET, b"HS_KEY_PAIR_GEN", HS_SEED, 32)[::-1], "big")
+sensor_cert = pair[2 + 400:]
+host_cert = cert(host_d, hs_d)
+sp = sensor_cert
+sx = int.from_bytes(sp[4:36][::-1], "big")
+sy = int.from_bytes(sp[72:104][::-1], "big")
+sensor_pub = ec.EllipticCurvePublicNumbers(sx, sy, ec.SECP256R1()).public_key()
+
+arr("vec_pair_reply", pair)
+arr("vec_server_flight", sh_record)
+arr("vec_host_secret", be(host_d))
+arr("vec_hs_secret", be(hs_d))
+arr("vec_host_cert", host_cert)
+
+# standalone PRF vector, SHA-384 like the session
+pm = bytes(range(32))
+seed64 = bytes(range(64, 128))
+arr("vec_prf_secret", pm)
+arr("vec_prf_seed", seed64)
+arr("vec_prf_out", prf(hashlib.sha384, pm, b"key expansion", seed64, 72))
+
+# the stream and one record sealed with fixed keys
+st = Stream(SEED)
+arr("vec_stream_first", st.take(40))
+key = bytes(range(32))
+salt = bytes.fromhex("a1a2a3a4")
+msg = b"hello tudor, record layer"
+nonce = Stream(SEED).take(8)
+arr("vec_rec_key", key)
+arr("vec_rec_salt", salt)
+arr("vec_rec_plain", msg)
+arr("vec_rec_sealed_seq5", record(23, seal(key, salt, 5, 23, msg, nonce)))
+arr("vec_rec_sealed_seq6_other_nonce", record(23, seal(key, salt, 6, 23, msg, bytes(range(8)))))
+
+# handshake
+st = Stream(SEED)
+cr = st.take(32)
+ch_body = (bytes([3, 3]) + cr + bytes([7]) + bytes(7) +
+           bytes.fromhex("000cc005c02e003d008d00a800a9") + b"\x00" +
+           bytes.fromhex("000a000400020017000b000201" "00"))
+ch = hs(1, ch_body)
+arr("vec_client_hello", record(22, ch))
+
+sh_payload = sh_record[5:]
+sr = sh_payload[4 + 2:4 + 2 + 32]
+eph_d = int.from_bytes(st.take(32), "big")
+ep = pub(eph_d)
+cert_msg = hs(11, u24(400) + u24(400) + bytes(2) + host_cert)
+cke = hs(16, b"\x04" + be(ep.x) + be(ep.y))
+transcript = ch + sh_payload + cert_msg + cke
+cv_digest = hashlib.sha256(transcript).digest()
+r, s = sign(host_d, cv_digest)
+cv = hs(15, bytes([0x30, 0x44, 2, 0x20]) + be(r) + bytes([2, 0x20]) + be(s))
+digest = hashlib.sha256(transcript + cv).digest()
+shared = ec.derive_private_key(eph_d, ec.SECP256R1()).exchange(ec.ECDH(), sensor_pub)
+master = prf(hashlib.sha384, shared, b"master secret", cr + sr, 48)
+kb = prf(hashlib.sha384, master, b"key expansion", cr + sr, 72)
+ck, sk, cs, ss = kb[:32], kb[32:64], kb[64:68], kb[68:72]
+cfin = hs(20, prf(hashlib.sha384, master, b"client finished", digest, 12))
+nonce = st.take(8)
+flight = (record(22, cert_msg + cke + cv) + bytes.fromhex("140303000101") +
+          record(22, seal(ck, cs, 0, 22, cfin, nonce)))
+arr("vec_flight", flight)
+arr("vec_cv_digest", cv_digest)
+arr("vec_master", master)
+arr("vec_keyblock", kb)
+sfin = hs(20, prf(hashlib.sha384, master, b"server finished", digest, 12))
+arr("vec_server_finished", bytes.fromhex("140303000101") + record(22, seal(sk, ss, 0, 22, sfin, b"SERVERIV")))
+
+# after the handshake: the client sends sequence 1, the sensor answers 1 and 2
+cmd = bytes.fromhex("9e01")
+arr("vec_app_cmd", cmd)
+arr("vec_app_sent", record(23, seal(ck, cs, 1, 23, cmd, st.take(8))))
+reply = bytes.fromhex("0000") + bytes(range(10))
+arr("vec_app_reply", reply)
+arr("vec_app_recv_seq1", record(23, seal(sk, ss, 1, 23, reply, b"REPLY001")))
+arr("vec_app_recv_seq2", record(23, seal(sk, ss, 2, 23, reply, b"REPLY002")))
+arr("vec_server_alert", record(21, seal(sk, ss, 2, 21, bytes([2, 40]), b"ALERT001")))
+arr("vec_close_notify", record(21, seal(ck, cs, 2, 21, bytes([1, 0]), st.take(8))))
+
+# signature encodings: der in, fixed 70 bytes out
+cases = [
+    (0x1234, 0x5678),
+    (1 << 255 | 5, 7),
+    (9, 1 << 255 | 3),
+    (1 << 255 | 1, 1 << 255 | 2),
+    ((1 << 248) - 1, 1 << 100),
+]
+for i, (r, s) in enumerate(cases):
+    der = encode_dss_signature(r, s)
+    arr("vec_sig%d_der" % i, der)
+    arr("vec_sig%d_fixed" % i, bytes([0x30, 0x44, 2, 0x20]) + be(r) + bytes([2, 0x20]) + be(s))
+out.append("#define VEC_SIG_CASES %d\n" % len(cases))
+
+print("/* Generated by tudor-tls-vectors.py, do not edit */\n")
+print("\n".join(out))
