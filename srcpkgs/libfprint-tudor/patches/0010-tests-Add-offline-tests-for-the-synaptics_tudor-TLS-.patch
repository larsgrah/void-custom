+#define SEED ((const guint8 *) "tudor emulation seed, not secret")
+
+#define assert_bytes(actual, actual_len, expected) \
+  G_STMT_START { \
+    g_assert_cmpuint ((actual_len), ==, sizeof (expected)); \
+    g_assert_cmpmem ((actual), (actual_len), (expected), sizeof (expected)); \
+  } G_STMT_END
+
+static void
+test_stream (void)
+{
+  guint8 buf[40];
+
+  tudor_tls_set_seed (SEED);
+  g_assert_true (tls_random (buf, sizeof (buf)));
+  tudor_tls_set_seed (NULL);
+  assert_bytes (buf, sizeof (buf), vec_stream_first);
+}
+
+static void
+test_prf (void)
+{
+  guint8 out[72];
+  guint8 secret[32];
+  g_autoptr(EVP_PKEY) key = NULL;
+  g_autoptr(GError) error = NULL;
+
+  g_assert_true (tls_prf (EVP_sha384 (), vec_prf_secret, sizeof (vec_prf_secret),
+                          "key expansion", vec_prf_seed, sizeof (vec_prf_seed),
+                          out, sizeof (out)));
+  assert_bytes (out, sizeof (out), vec_prf_out);
+
+  /* The key the vendor signs host certificates with */
+  key = hs_key_new (&error);
+  g_assert_no_error (error);
+  g_assert_true (tudor_key_export (key, secret, &error));
+  assert_bytes (secret, sizeof (secret), vec_hs_secret);
+}
+
+static void
+test_cert (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(EVP_PKEY) host = tudor_key_import (vec_host_secret, &error);
+  g_autoptr(EVP_PKEY) pub = NULL;
+  g_autoptr(EVP_PKEY) pub2 = NULL;
+  guint8 cert[TUDOR_CERT_SIZE];
+  guint8 sensor[TUDOR_CERT_SIZE];
+  guint8 point[65], point2[65];
+  gsize len = 0, len2 = 0;
+
+  g_assert_no_error (error);
+
+  /* Host certificate, RFC 6979 signatures make the bytes repeatable */
+  tudor_tls_set_seed (SEED);
+  g_assert_true (tudor_cert_make_host (host, cert, &error));
+  tudor_tls_set_seed (NULL);
+  g_assert_no_error (error);
+  assert_bytes (cert, sizeof (cert), vec_host_cert);
+
+  /* The public key survives the round trip */
+  pub = tudor_cert_get_pubkey (cert, &error);
+  g_assert_no_error (error);
+  g_assert_true (EVP_PKEY_get_octet_string_param (host, OSSL_PKEY_PARAM_PUB_KEY, point,
+                                                  sizeof (point), &len));
+  g_assert_true (EVP_PKEY_get_octet_string_param (pub, OSSL_PKEY_PARAM_PUB_KEY, point2,
+                                                  sizeof (point2), &len2));
+  g_assert_cmpmem (point, len, point2, len2);
+
+  /* Not a certificate */
+  cert[0] ^= 1;
+  g_assert_null (tudor_cert_get_pubkey (cert, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_clear_error (&error);
+
+  /* The sensor certificate of the real pairing reply is signed by the
+   * key for its firmware */
+  memcpy (sensor, vec_pair_reply + 2 + TUDOR_CERT_SIZE, sizeof (sensor));
+  g_assert_true (tudor_cert_verify_sensor (sensor, 10, 1, TRUE, &error));
+  g_assert_no_error (error);
+  pub2 = tudor_cert_get_pubkey (sensor, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (pub2);
+
+  g_assert_false (tudor_cert_verify_sensor (sensor, 10, 1, FALSE, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO);
+  g_clear_error (&error);
+  g_assert_false (tudor_cert_verify_sensor (sensor, 9, 9, TRUE, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED);
+  g_clear_error (&error);
+  sensor[10] ^= 1;
+  g_assert_false (tudor_cert_verify_sensor (sensor, 10, 1, TRUE, &error));
+  g_clear_error (&error);
+  sensor[10] ^= 1;
+  sensor[CERT_OFF_SIGLEN] = 0;
+  sensor[CERT_OFF_SIGLEN + 1] = 0;
+  g_assert_false (tudor_cert_verify_sensor (sensor, 10, 1, TRUE, &error));
+  g_clear_error (&error);
+}
