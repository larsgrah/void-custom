index 00000000..b4d6b978
--- /dev/null
+++ b/examples/tudor-owner-session.sh
@@ -0,0 +1,59 @@
+#!/bin/sh
+# One terminal session for everything that needs a finger (not for upstream).
+# Run it from the libfprint-tudor checkout after building with ninja -C build.
+#
+# It stops fprintd while it runs (sudo, polkit and the lock use the password
+# meanwhile) and always gives the sensor back, also when it fails or is
+# interrupted. It only deletes the one print it enrolls itself. Logs go to
+# ~/.cache/tudor-traces/owner-session/.
+#
+# Fingers: the TEST finger is the LEFT INDEX finger, which must not be
+# enrolled on the sensor. The USUAL finger is one that already is.
+# Needs 7 touches for the enroll, about 20 touches all in all.
+
+set -u
+
+root=$(cd "$(dirname "$0")/.." && pwd)
+bin=$root/build/examples/tudor-session
+devmode=/usr/local/libexec/velarium/tudor-devmode
+logdir=$HOME/.cache/tudor-traces/owner-session
+stamp=$(date +%Y%m%d-%H%M%S)
+
+[ -x "$bin" ] || { echo "build first: ninja -C build"; exit 1; }
+mkdir -p "$logdir"
+
+restore() {
+    sudo -n "$devmode" off >/dev/null 2>&1 || sudo "$devmode" off
+    echo "sensor given back to fprintd"
+}
+trap restore EXIT
+trap 'exit 130' INT TERM
+
+sudo "$devmode" on || exit 1
+export FP_TUDOR_PAIRING_DIR=$HOME/.cache/tudor-pairing
+export G_MESSAGES_DEBUG=all
+
+echo "Step 1 of 3: read only checks, do not touch the sensor"
+env G_MESSAGES_DEBUG=all "$bin" 2> "$logdir/$stamp-readonly.debug" | tee "$logdir/$stamp-readonly.log"
+
+echo
+echo "Step 2 of 3: an enroll that dies half way, nothing to touch"
+echo "  If the sensor has no free slots this reclaims the deleted ones first (the"
+echo "  vendor cleanup), that is wanted and shows in the log."
+env G_MESSAGES_DEBUG=all "$bin" --abandon-enroll 2> "$logdir/$stamp-abandon.debug" | tee "$logdir/$stamp-abandon.log"
+
+echo
+echo "Step 3 of 3: finger tests. You will be told which finger and when."
+echo "  TEST finger  = LEFT INDEX (must not be enrolled yet)"
+echo "  USUAL finger = a finger that is enrolled already"
+printf "Press enter to start, ctrl-c to stop: "
+read -r _
+
+env G_MESSAGES_DEBUG=all "$bin" --finger-tests 2> "$logdir/$stamp-fingers.debug" | tee "$logdir/$stamp-fingers.log"
+grep -q "^PASSED" "$logdir/$stamp-fingers.log"
+rc=$?
+
+echo
+echo "Logs are in $logdir, files starting with $stamp"
+echo "Send back: $stamp-fingers.log and $stamp-fingers.debug"
+exit $rc
