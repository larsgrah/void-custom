+/* Checks a signature is DER of two minimal positive integers and sets the
+ * integer lengths. Also lets OpenSSL read it and write it again, the bytes
+ * must come out the same. */
+static gboolean
+sig_is_minimal_der (const guint8 *d,
+                    gsize         len,
+                    gsize        *r_len,
+                    gsize        *s_len)
+{
+  const guint8 *p = d;
+  ECDSA_SIG *sig;
+  g_autofree guint8 *again = NULL;
+  int again_len;
+  gsize rl, sl;
+
+  if (len < 8 || d[0] != 0x30 || d[1] != len - 2 || d[2] != 0x02)
+    return FALSE;
+  rl = d[3];
+  if (rl == 0 || 4 + rl + 2 > len || d[4 + rl] != 0x02)
+    return FALSE;
+  sl = d[5 + rl];
+  if (sl == 0 || 6 + rl + sl != len)
+    return FALSE;
+  /* No negative integers, no needless leading zero */
+  if ((d[4] & 0x80) || (rl > 1 && d[4] == 0 && !(d[5] & 0x80)))
+    return FALSE;
+  if ((d[6 + rl] & 0x80) || (sl > 1 && d[6 + rl] == 0 && !(d[7 + rl] & 0x80)))
+    return FALSE;
+
+  sig = d2i_ECDSA_SIG (NULL, &p, len);
+  if (!sig)
+    return FALSE;
+  again_len = i2d_ECDSA_SIG (sig, &again);
+  ECDSA_SIG_free (sig);
+  *r_len = rl;
+  *s_len = sl;
+  return again_len == (int) len && again && memcmp (again, d, len) == 0;
+}
+
+/* The integer in a fixed width big endian array, as the generator wrote it */
+static void
+check_int (const guint8 *der_int,
+           gsize         der_len,
+           const guint8 *be32)
+{
+  guint8 padded[32] = { 0 };
+
+  if (der_int[0] == 0)
+    {
+      der_int++;
+      der_len--;
+    }
+  g_assert_cmpuint (der_len, <=, 32);
+  memcpy (padded + 32 - der_len, der_int, der_len);
+  g_assert_cmpmem (padded, 32, be32, 32);
+}
