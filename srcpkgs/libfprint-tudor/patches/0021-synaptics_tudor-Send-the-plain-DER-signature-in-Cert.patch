From 95b799826498bad87a4556f312e738c74cb67655 Mon Sep 17 00:00:00 2001
From: Lars Grahmann <lars.grahmann@googlemail.com>
Date: Thu, 29 Oct 2026 22:25:07 +0100
Subject: [PATCH 21/22] synaptics_tudor: Send the plain DER signature in
 CertificateVerify

The sensor does not need the fixed 70 byte form. The vendor driver sent
70 and 72 byte DER signatures in the traces and the sensor took both,
and the fixed form wrote a negative integer when the top bit was set.
Tests now check minimal DER, the client flight and the vendor trace
bodies.
---
 libfprint/drivers/synaptics_tudor/tudor_tls.c |  42 +----
 tests/test-tudor-tls-vectors.h                | 151 ++++++++++++-----
 tests/test-tudor-tls.c                        | 152 ++++++++++++++++--
 tests/tudor-tls-vectors.py                    |  45 +++++-
 4 files changed, 294 insertions(+), 96 deletions(-)

diff --git a/libfprint/drivers/synaptics_tudor/tudor_tls.c b/libfprint/drivers/synaptics_tudor/tudor_tls.c
index 3cb6c2e6..0def460b 100644
--- a/libfprint/drivers/synaptics_tudor/tudor_tls.c
+++ b/libfprint/drivers/synaptics_tudor/tudor_tls.c
@@ -19,9 +19,8 @@
  *
  * This is a small TLS 1.2 client written by hand because libssl cannot talk
  * to the sensor. Its hello has no compression field and no extension
- * length, certificates are not X.509, signatures must be exactly 70 bytes
- * and the key block uses the random values in a non-standard order. Only
- * OpenSSL primitives are used.
+ * length, certificates are not X.509 and the key block uses the random
+ * values in a non-standard order. Only OpenSSL primitives are used.
  */
 
 #define FP_COMPONENT "synaptics_tudor"
@@ -847,33 +846,6 @@ take_record (const guint8 **data,
   return TRUE;
 }
 
-/* The sensor only takes signatures of exactly 70 bytes, a DER sequence of
- * two 32 byte integers, with no extra zero byte when the top bit is set */
-static gboolean
-sig_to_fixed (const guint8 *der,
-              gsize         der_len,
-              guint8        out[70])
-{
-  const guint8 *p = der;
-  ECDSA_SIG *sig = d2i_ECDSA_SIG (NULL, &p, der_len);
-  const BIGNUM *r, *s;
-  gboolean ok = FALSE;
-
-  if (!sig)
-    return FALSE;
-
-  ECDSA_SIG_get0 (sig, &r, &s);
-  out[0] = 0x30;
-  out[1] = 0x44;
-  out[2] = 0x02;
-  out[3] = 0x20;
-  out[36] = 0x02;
-  out[37] = 0x20;
-  ok = BN_bn2binpad (r, out + 4, 32) == 32 && BN_bn2binpad (s, out + 38, 32) == 32;
-  ECDSA_SIG_free (sig);
-  return ok;
-}
-
 GByteArray *
 tudor_tls_handle_server_hello (TudorTls     *tls,
                                const guint8 *data,
@@ -1050,16 +1022,12 @@ tudor_tls_handle_server_hello (TudorTls     *tls,
       set_ssl_error (error, "Could not sign handshake");
       return NULL;
     }
+  /* The body is the plain DER signature, 69 to 72 bytes */
   {
     gsize before = hs->len;
-    guint8 fixed[70];
 
-    if (!sig_to_fixed (sig, sig_len, fixed))
-      {
-        set_ssl_error (error, "Could not encode signature");
-        return NULL;
-      }
-    add_handshake (hs, HS_CERT_VERIFY, fixed, sizeof (fixed));
+    fp_dbg ("certificate verify signature is %" G_GSIZE_FORMAT " bytes", sig_len);
+    add_handshake (hs, HS_CERT_VERIFY, sig, sig_len);
     if (EVP_DigestUpdate (tls->hs_hash, hs->data + before, hs->len - before) != 1)
       {
         set_ssl_error (error, "Could not hash the handshake");
