+def vendor_cert_verify(path):
+    for line in open(path):
+        parts = line.split()
+        if len(parts) < 3 or parts[0] != "COUT":
+            continue
+        data = bytes.fromhex(parts[2])[8:]
+        if not data or data[0] != 0x44:
+            continue
+        recs = data[4:]
+        i = 0
+        while i + 5 <= len(recs):
+            ln = int.from_bytes(recs[i + 3:i + 5], "big")
+            body = recs[i + 5:i + 5 + ln]
+            ctype = recs[i]
+            i += 5 + ln
+            j = 0
+            while ctype == 0x16 and j + 4 <= len(body):
+                hlen = int.from_bytes(body[j + 1:j + 4], "big")
+                if body[j] == 0x0f:
+                    return body[j + 4:j + 4 + hlen]
+                j += 4 + hlen
+    return None
+
