diff --git a/libfprint/drivers/synaptics_tudor/tudor.c b/libfprint/drivers/synaptics_tudor/tudor.c
index 943115dd..a51d5756 100644
--- a/libfprint/drivers/synaptics_tudor/tudor.c
+++ b/libfprint/drivers/synaptics_tudor/tudor.c
@@ -1091,6 +1091,14 @@ enum {
 static void open_use_pairing (FpiDeviceSynapticsTudor *self,
                               FpiSsm                  *ssm);
 
+/* Debug env (dev branch only): FP_TUDOR_NEVER_REPAIR makes an open fail where
+ * it would pair the sensor again. Pairing again orphans every template. */
+static gboolean
+tudor_never_repair (void)
+{
+  return g_getenv ("FP_TUDOR_NEVER_REPAIR") != NULL;
+}
+
 static void
 open_version_done (FpiDeviceSynapticsTudor *self,
                 FpiSsm                  *ssm)
@@ -1242,7 +1250,7 @@ open_flight_done (FpiDeviceSynapticsTudor *self,
       /* Only a clear no from the sensor means the pairing is gone. Anything
        * else could be a glitch and the pairing is the only way to the
        * templates, so it stays where it is. */
-      if (self->pairing_from_file && rejected)
+      if (self->pairing_from_file && rejected && !tudor_never_repair ())
         {
           fp_warn ("sensor rejected the stored pairing (%s), pairing again, "
                    "templates enrolled before will not match", error->message);
@@ -1292,6 +1300,13 @@ open_run_state (FpiSsm   *ssm,
         guint8 cmd[1 + TUDOR_CERT_SIZE] = { TUDOR_CMD_PAIR };
         guint8 cert[TUDOR_CERT_SIZE];
 
+        if (tudor_never_repair ())
+          {
+            fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                                                "Would pair the sensor again, FP_TUDOR_NEVER_REPAIR is set"));
+            return;
+          }
+
         /* Pairing replaces the host key the sensor knows, so the new one
          * has to be storable first */
         if (!fpi_device_emulation_mode_enabled (device) &&
