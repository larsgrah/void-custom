From fe1c46eb7d9e2890482b4b1aeb0e841c392197db Mon Sep 17 00:00:00 2001
From: Lars Grahmann <lars.grahmann@googlemail.com>
Date: Thu, 29 Oct 2026 22:42:55 +0100
Subject: [PATCH 25/33] tests: Rework the synaptics_tudor custom test for the
 recording

---
 tests/meson.build               |  3 +--
 tests/synaptics_tudor/README.md | 25 ++++++++++++------
 tests/synaptics_tudor/custom.py | 46 ++++++++++++++++++++++++++++-----
 tests/synaptics_tudor/device    | 23 -----------------
 4 files changed, 57 insertions(+), 40 deletions(-)
 delete mode 100644 tests/synaptics_tudor/device

diff --git a/tests/meson.build b/tests/meson.build
index fbd96d5e..f0b26f0a 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -66,8 +66,7 @@ drivers_tests = {
     'secugen': {},
 }
 
-# Needs a recording made on a sensor that can be paired from scratch, see
-# synaptics_tudor/README.md
+# Skipped until the recording exists, see synaptics_tudor/README.md
 if fs.exists('synaptics_tudor/custom.pcapng')
     drivers_tests += { 'synaptics_tudor': {} }
 endif
diff --git a/tests/synaptics_tudor/README.md b/tests/synaptics_tudor/README.md
index 4e32e1c5..3f6e1fe2 100644
--- a/tests/synaptics_tudor/README.md
+++ b/tests/synaptics_tudor/README.md
@@ -1,15 +1,24 @@
 # synaptics_tudor umockdev test
 
-`device` and `custom.py` are in place, `custom.pcapng` is missing, so the test
-is not run yet (tests/meson.build picks it up once the file exists).
+`custom.py` is in place, `device` and `custom.pcapng` come from the recorder.
+Until `custom.pcapng` exists the test is not run (tests/meson.build picks it
+up once the file is there).
 
 The recording replays byte for byte because in emulation mode the driver
 seeds all randomness, uses a fixed host key and never reads or writes the
-pairing file. That also means the sensor must be paired during the recording
-with that fixed key. A pairing replaces the host key the sensor knows, every
+pairing file. That also means the sensor is paired with that public key
+during the recording. A pairing replaces the host key the sensor knows, every
 template enrolled before stops matching. Record on a sensor that holds
-nothing of value, never on one in daily use.
+nothing of value, never on one in daily use, and pair it again with a random
+key afterwards (delete the pairing file, the driver pairs on the next open).
 
-Record with `tests/capture.py` (see tests/README.md) running `custom.py`
-with `FP_DEVICE_EMULATION=1` and a finger for the 7 enroll touches, one
-verify and one identify. Anonymize the serial in `device`.
+`custom.py` clears the storage first like the other MoC tests, enrolls one
+finger (7 touches), tries the same finger again for the duplicate check
+(1 touch), then verify (1) and identify (1) and deletes the print.
+
+Record from the build directory as root, with FP_DEVICE_EMULATION set by the
+recorder:
+
+    tests/create-driver-test.py --test custom synaptics_tudor
+
+Anonymize the serial in `device` afterwards.
diff --git a/tests/synaptics_tudor/custom.py b/tests/synaptics_tudor/custom.py
index e2dedabd..568046d5 100644
--- a/tests/synaptics_tudor/custom.py
+++ b/tests/synaptics_tudor/custom.py
@@ -28,34 +28,65 @@ assert d.has_feature(FPrint.DeviceFeature.STORAGE_LIST)
 assert d.has_feature(FPrint.DeviceFeature.STORAGE_DELETE)
 assert d.has_feature(FPrint.DeviceFeature.STORAGE_CLEAR)
 
+def say(text):
+    print('\n>>> ' + text, flush=True)
+
+FINGER = FPrint.Finger.RIGHT_MIDDLE
+DESCRIPTION = 'FP1-00000000-%X-00000000-tudor-test' % int(FINGER)
+
+say('Use ONE finger for everything below: your RIGHT MIDDLE finger.')
+
 d.open_sync()
 
-# The recording starts on an empty sensor
+# The recording pairs the sensor from scratch, which already made every
+# template enrolled before unusable. Clearing like the other MoC tests do
+# loses nothing and gives back their slots.
 d.clear_storage_sync()
+assert len(d.list_prints_sync()) == 0
 
 template = FPrint.Print.new(d)
-template.set_finger(FPrint.Finger.LEFT_INDEX)
+template.set_finger(FINGER)
 template.set_username('tudor-test')
 
 def enroll_progress(*args):
     assert d.get_finger_status() & FPrint.FingerStatusFlags.NEEDED
-    print('enroll progress: ' + str(args))
+    print('enroll progress: ' + str(args), flush=True)
+    if args[3] is not None:
+        say('That touch was refused, lift the finger and try again')
+    elif args[1] < d.get_nr_enroll_stages():
+        say('Lift the finger and touch the sensor again')
 
+say('ENROLL: touch the sensor, lift, repeat (7 touches)')
 assert d.get_finger_status() == FPrint.FingerStatusFlags.NONE
 p = d.enroll_sync(template, None, enroll_progress, None)
 assert d.get_finger_status() == FPrint.FingerStatusFlags.NONE
-assert p.get_description() == 'FP1-00000000-2-00000000-tudor-test'
+assert p.get_description() == DESCRIPTION
 
 stored = d.list_prints_sync()
 assert len(stored) == 1
 assert stored[0].equal(p)
-assert stored[0].get_description() == 'FP1-00000000-2-00000000-tudor-test'
+assert stored[0].get_description() == DESCRIPTION
 assert stored[0].get_username() == 'tudor-test'
-assert stored[0].get_finger() == FPrint.Finger.LEFT_INDEX
-
+assert stored[0].get_finger() == FINGER
+
+# The same finger again is a duplicate and stops after the first touch
+say('DUPLICATE CHECK: touch the sensor once more')
+dup = FPrint.Print.new(d)
+dup.set_finger(FINGER)
+dup.set_username('tudor-test')
+try:
+    d.enroll_sync(dup, None, None, None)
+    assert False, 'duplicate enroll was not refused'
+except GLib.Error as error:
+    assert error.matches(FPrint.DeviceError.quark(),
+                         FPrint.DeviceError.DATA_DUPLICATE)
+assert len(d.list_prints_sync()) == 1
+
+say('VERIFY: touch the sensor once')
 verify_res, verify_print = d.verify_sync(p)
 assert verify_res
 
+say('IDENTIFY: touch the sensor once')
 match, _ = d.identify_sync(stored)
 assert match.equal(p)
 
@@ -63,3 +94,4 @@ d.delete_print_sync(p)
 assert len(d.list_prints_sync()) == 0
 
 d.close_sync()
+say('All done')
