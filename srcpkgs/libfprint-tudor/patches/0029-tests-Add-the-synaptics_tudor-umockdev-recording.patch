From 2a26d1bf02394fa4896a92db57187317ed2406e4 Mon Sep 17 00:00:00 2001
From: Lars Grahmann <lars.grahmann@googlemail.com>
Date: Thu, 29 Oct 2026 22:54:55 +0100
Subject: [PATCH 29/30] tests: Add the synaptics_tudor umockdev recording

Recorded on a Kensington VeriMark DT with FP_DEVICE_EMULATION set, so the
handshake uses the fixed test keys and replays byte for byte. The key's
FIDO interface was filtered out of the capture, the kernel polls it and
replay would wait on those urbs. The USB serial is zeroed in the device
dump. The recording wrapper now does both itself.
---
 examples/tudor-record-umockdev.sh |  10 +
 tests/meson.build                 |   5 +-
 tests/synaptics_tudor/device      | 480 ++++++++++++++++++++++++++++++
 3 files changed, 491 insertions(+), 4 deletions(-)
 create mode 100644 tests/synaptics_tudor/device

diff --git a/examples/tudor-record-umockdev.sh b/examples/tudor-record-umockdev.sh
index bb9e8d56..0329815d 100755
--- a/examples/tudor-record-umockdev.sh
+++ b/examples/tudor-record-umockdev.sh
@@ -256,6 +256,16 @@ rc=${PIPESTATUS[0]}
 grep -q "Running the custom fingerprint capture" "$log" && pairing_touched=1
 sudo chown -R "$(id -u):$(id -g)" "$testdir"
 
+# interface 0 is the key's fido hid side, the kernel keeps polling it and
+# replay would wait forever for those urbs, so only the sensor's traffic stays
+if [ "$rc" = 0 ] && [ -e "$testdir/custom.pcapng" ]; then
+    tshark -r "$testdir/custom.pcapng" -w "$testdir/custom.filtered.pcapng" \
+        -Y 'usb.endpoint_address != 0x81 && usb.endpoint_address != 0x01' &&
+        mv "$testdir/custom.filtered.pcapng" "$testdir/custom.pcapng"
+    # the usb serial is the only identifying bit and nothing reads it
+    sed -i 's/^\(E: ID_SERIAL=.*_\)[0-9a-f]\{12\}$/\1000000000000/; s/^\(E: ID_SERIAL_SHORT=\)[0-9a-f]\{12\}$/\1000000000000/; s/^\(A: serial=\)[0-9a-f]\{12\}\\n$/\1000000000000\\n/' "$testdir/device"
+fi
+
 if [ "$rc" != 0 ]; then
     say "the recording FAILED (exit $rc)"
     if [ "$pairing_touched" = 1 ]; then
diff --git a/tests/meson.build b/tests/meson.build
index f0b26f0a..d057f4a9 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -40,6 +40,7 @@ drivers_tests = {
     'elanmoc': {},
     'elanspi': { 'timeout': 30 },
     'synaptics': {},
+    'synaptics_tudor': {},
     'upektc_img': {},
     'upektc_img-tcs1s': {},
     'uru4000-msv2': {},
@@ -66,10 +67,6 @@ drivers_tests = {
     'secugen': {},
 }
 
-# Skipped until the recording exists, see synaptics_tudor/README.md
-if fs.exists('synaptics_tudor/custom.pcapng')
-    drivers_tests += { 'synaptics_tudor': {} }
-endif
 
 if get_option('introspection')
   conf = configuration_data()
