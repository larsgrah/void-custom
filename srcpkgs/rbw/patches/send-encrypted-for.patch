                 crate::db::EntryData::SecureNote => 2,
@@ -1768,3 +1774,12 @@ fn classify_login_error(error_res: &ConnectErrorRes, code: u16) -> Error {
     log::warn!("unexpected error received during login: {error_res:?}");
     Error::RequestFailed { status: code }
 }
+
+// vaultwarden 1.37+ wants the user id on cipher create/update, it's the
+// access token's sub claim
+fn user_id_from_access_token(access_token: &str) -> Option<String> {
+    let payload = access_token.split('.').nth(1)?;
+    let bytes = crate::base64::decode_url_safe_no_pad(payload).ok()?;
+    let claims: serde_json::Value = serde_json::from_slice(&bytes).ok()?;
+    claims.get("sub")?.as_str().map(std::string::ToString::to_string)
+}
diff --git a/src/base64.rs b/src/base64.rs
