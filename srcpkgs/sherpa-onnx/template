# Template file for 'sherpa-onnx'
pkgname=sherpa-onnx
version=1.13.6
revision=2
build_style=cmake
# the diarization binary is the only reason this is here, so everything that
# drags in an audio device, a socket or a voice synthesiser is off. cmake
# would otherwise fetch its own onnxruntime, which xbps-src has no network for
configure_args="-DBUILD_SHARED_LIBS=ON
 -DSHERPA_ONNX_ENABLE_PYTHON=OFF -DSHERPA_ONNX_ENABLE_TESTS=OFF
 -DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF -DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF
 -DSHERPA_ONNX_ENABLE_TTS=OFF -DSHERPA_ONNX_ENABLE_JNI=OFF
 -DSHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION=ON
 -DSHERPA_ONNX_ENABLE_BINARY=ON -DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF
 -DSHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE=ON
 -DSHERPA_ONNXRUNTIME_INCLUDE_DIR=/usr/include/onnxruntime
 -DSHERPA_ONNXRUNTIME_LIB_DIR=/usr/lib"
hostmakedepends="pkg-config"
makedepends="onnxruntime-bin"
depends="onnxruntime-bin"
short_desc="Speech recognition, diarization and VAD with onnxruntime"
maintainer="Lars Grahmann <void@lars.earth>"
license="Apache-2.0"
homepage="https://github.com/k2-fsa/sherpa-onnx"
# cmake FetchContents these at configure time and xbps-src has no network,
# so they come down as distfiles and get dropped where each cmake/*.cmake
# already looks for a pre-downloaded copy - the source dir
_knf=1.22.3
_kd=0.3.0
_ssp=0.7
_json=3.12.0
_hclust=2026-02-25
# transitive: kissfft comes from kaldi-native-fbank, kaldi-decoder wants
# eigen and kaldifst. sherpa ships its own eigen.cmake and openfst.cmake
# pinned newer than the ones its own dependencies ask for, and those are the
# versions that win. cmake/download-all-deps.py upstream lists the real set
_kissfft=febd4caeed32e33ad8b2e0bb5ea77542c40f18ec
_eigen=5.0.1
_kaldifst=1.8.0
_openfst=1.8.5-2026-07-09
distfiles="https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v${version}.tar.gz
 https://github.com/csukuangfj/kaldi-native-fbank/archive/refs/tags/v${_knf}.tar.gz>kaldi-native-fbank-${_knf}.tar.gz
 https://github.com/k2-fsa/kaldi-decoder/archive/refs/tags/v${_kd}.tar.gz>kaldi-decoder-${_kd}.tar.gz
 https://github.com/pkufool/simple-sentencepiece/archive/refs/tags/v${_ssp}.tar.gz>simple-sentencepiece-${_ssp}.tar.gz
 https://github.com/nlohmann/json/archive/refs/tags/v${_json}.tar.gz>json-${_json}.tar.gz
 https://github.com/csukuangfj/hclust-cpp/archive/refs/tags/${_hclust}.tar.gz>hclust-cpp-${_hclust}.tar.gz
 https://github.com/mborgerding/kissfft/archive/${_kissfft}.zip>kissfft-${_kissfft}.zip
 https://gitlab.com/libeigen/eigen/-/archive/${_eigen}/eigen-${_eigen}.tar.gz>eigen-${_eigen}.tar.gz
 https://github.com/k2-fsa/kaldifst/archive/refs/tags/v${_kaldifst}.tar.gz>kaldifst-${_kaldifst}.tar.gz
 https://github.com/csukuangfj/openfst/archive/refs/tags/v${_openfst}.tar.gz>openfst-${_openfst}.tar.gz"
checksum="78f5d10f957d2de1867a1e08395e9ec2ec388911c853dd141887396667f3ff34
 9176cc66fc7ce1edf85cf355b06e320c57db6297df74277f575183468893cf61
 b9f34cfb4fd3b1344100eead79ef4d37aa15962274b9e3056de345021f76a1b0
 1748a822060a35baa9f6609f84efc8eb54dc0e74b9ece3d82367b7119fdc75af
 4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187
 8f14e024c709d73afb40ae69cb22de4b73dba67cbce40f2e518813da8139ab56
 497103e664168ebe39580b757adbe616f6cf85a16572af581ca7bc42d0ab13fd
 e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec
 3f247b7e5a2409071202f5e2bc6200060f66728c0a3443c03923ad2723e040b3
 2ff712a32952fcb01d351121a6bc8ccf4fdc6b2aa06ce8df2b3095dedd518c0e"
skip_extraction="kaldi-native-fbank-${_knf}.tar.gz kaldi-decoder-${_kd}.tar.gz
 simple-sentencepiece-${_ssp}.tar.gz json-${_json}.tar.gz
 hclust-cpp-${_hclust}.tar.gz kissfft-${_kissfft}.zip
 eigen-${_eigen}.tar.gz kaldifst-${_kaldifst}.tar.gz openfst-${_openfst}.tar.gz"
archs="x86_64"

post_extract() {
	local d="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	for f in ${skip_extraction}; do
		cp "${d}/${f}" "${wrksrc}/${f}"
		# a transitive dep looks next to its own source, which does not
		# exist until cmake has populated it. /tmp is the one slot in
		# every one of these lists that we can fill in advance
		cp "${d}/${f}" "/tmp/${f}"
	done
}

post_install() {
	vlicense LICENSE
}
