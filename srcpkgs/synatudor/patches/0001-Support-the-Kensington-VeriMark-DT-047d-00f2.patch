+//Firmware updates through an emulated driver are how sensors get bricked, so
+//the two entry points into flashing are patched to fail. Both patches check the
+//original bytes first, a different driver build refuses to start instead.
+static const struct {
+    uint32_t rva;
+    uint8_t orig[8];
+} fw_update_blocks[] = {
+    { 0x8d8b0, { 0x48, 0x89, 0x4c, 0x24, 0x08, 0x48, 0x83, 0xec } }, //_tudorBootLoaderModeEnter
+    { 0x81fb0, { 0x44, 0x89, 0x44, 0x24, 0x18, 0x48, 0x89, 0x54 } }, //MFW/CFG patch download
+};
+
+static bool block_fw_updates(struct dll_image *img) {
+    //mov eax, 0x6e; ret - 0x6e is what the bootloader entry returns on failure too
+    static const uint8_t fail_ret[] = { 0xb8, 0x6e, 0x00, 0x00, 0x00, 0xc3 };
+    long page = sysconf(_SC_PAGESIZE);
+
+    for(size_t i = 0; i < sizeof(fw_update_blocks) / sizeof(fw_update_blocks[0]); i++) {
+        uint8_t *fnc = (uint8_t*) img->base_addr + fw_update_blocks[i].rva;
+        if(memcmp(fnc, fw_update_blocks[i].orig, sizeof(fw_update_blocks[i].orig)) != 0) {
+            log_error("Driver DLL doesn't match the firmware update block at RVA 0x%x, refusing to load it!", fw_update_blocks[i].rva);
+            return false;
+        }
+
+        uint8_t *pg = (uint8_t*) ((uintptr_t) fnc & ~(uintptr_t) (page-1));
+        if(mprotect(pg, page*2, PROT_READ | PROT_WRITE)) { perror("Couldn't unprotect driver code"); return false; }
+        memcpy(fnc, fail_ret, sizeof(fail_ret));
+        if(mprotect(pg, page*2, PROT_READ | PROT_EXEC)) { perror("Couldn't reprotect driver code"); return false; }
+    }
+
+    log_info("Blocked firmware updates in the driver DLL");
+    return true;
+}
