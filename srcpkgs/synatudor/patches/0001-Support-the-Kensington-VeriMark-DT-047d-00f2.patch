diff --git a/libtudor/src/winapi/window.c b/libtudor/src/winapi/window.c
new file mode 100644
index 0000000..0d1ab28
--- /dev/null
+++ b/libtudor/src/winapi/window.c
@@ -0,0 +1,90 @@
+#include <pthread.h>
+#include <string.h>
+#include "internal.h"
+
+//The driver makes a hidden window to get power and session notifications.
+//Nothing ever sends those here, so the message loop just waits for a quit.
+
+#define WM_QUIT 0x0012
+
+static pthread_mutex_t msg_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t msg_cond = PTHREAD_COND_INITIALIZER;
+static bool msg_quit = false;
+static LONG_PTR wnd_longs[8];
+
+static void post_quit() {
+    cant_fail_ret(pthread_mutex_lock(&msg_lock));
+    msg_quit = true;
+    cant_fail_ret(pthread_cond_broadcast(&msg_cond));
+    cant_fail_ret(pthread_mutex_unlock(&msg_lock));
+}
+
+__winfnc WORD RegisterClassExW(const void *cls) { return 0xc001; }
+WINAPI(RegisterClassExW)
+
+__winfnc BOOL UnregisterClassW(const char16_t *name, HANDLE inst) { return TRUE; }
+WINAPI(UnregisterClassW)
+
+__winfnc HANDLE CreateWindowExW(DWORD ex_style, const char16_t *cls, const char16_t *name, DWORD style, int x, int y, int w, int h, HANDLE parent, HANDLE menu, HANDLE inst, void *param) {
+    cant_fail_ret(pthread_mutex_lock(&msg_lock));
+    msg_quit = false;
+    memset(wnd_longs, 0, sizeof(wnd_longs));
+    cant_fail_ret(pthread_mutex_unlock(&msg_lock));
+    return (HANDLE) wnd_longs;
+}
+WINAPI(CreateWindowExW)
+
+__winfnc BOOL DestroyWindow(HANDLE wnd) {
+    post_quit();
+    return TRUE;
+}
+WINAPI(DestroyWindow)
+
+__winfnc LONG_PTR SetWindowLongPtrW(HANDLE wnd, int idx, LONG_PTR val) {
+    //GWLP_USERDATA is -21, the only one the driver should care about
+    LONG_PTR *slot = &wnd_longs[(-idx) & 7];
+    LONG_PTR old = *slot;
+    *slot = val;
+    return old;
+}
+WINAPI(SetWindowLongPtrW)
+
+__winfnc LONG_PTR GetWindowLongPtrW(HANDLE wnd, int idx) { return wnd_longs[(-idx) & 7]; }
+WINAPI(GetWindowLongPtrW)
+
+__winfnc BOOL GetMessageW(void *msg, HANDLE wnd, UINT min, UINT max) {
+    cant_fail_ret(pthread_mutex_lock(&msg_lock));
+    while(!msg_quit) cant_fail_ret(pthread_cond_wait(&msg_cond, &msg_lock));
+    msg_quit = false;
+    cant_fail_ret(pthread_mutex_unlock(&msg_lock));
+    return FALSE;
+}
+WINAPI(GetMessageW)
+
+__winfnc BOOL PostThreadMessageW(DWORD thread, UINT msg, ULONG_PTR wparam, LONG_PTR lparam) {
+    if(msg == WM_QUIT) post_quit();
+    else log_debug("PostThreadMessageW | ignored message 0x%x", msg);
+    return TRUE;
+}
+WINAPI(PostThreadMessageW)
+
+__winfnc BOOL TranslateMessage(const void *msg) { return FALSE; }
+WINAPI(TranslateMessage)
+
+__winfnc LONG_PTR DispatchMessageW(const void *msg) { return 0; }
+WINAPI(DispatchMessageW)
+
+__winfnc LONG_PTR DefWindowProcW(HANDLE wnd, UINT msg, ULONG_PTR wparam, LONG_PTR lparam) { return 0; }
+WINAPI(DefWindowProcW)
+
+__winfnc HANDLE RegisterPowerSettingNotification(HANDLE recipient, const GUID *setting, DWORD flags) { return (HANDLE) wnd_longs; }
+WINAPI(RegisterPowerSettingNotification)
+
+__winfnc BOOL UnregisterPowerSettingNotification(HANDLE handle) { return TRUE; }
+WINAPI(UnregisterPowerSettingNotification)
+
+__winfnc BOOL WTSRegisterSessionNotification(HANDLE wnd, DWORD flags) { return TRUE; }
+WINAPI(WTSRegisterSessionNotification)
+
+__winfnc BOOL WTSUnRegisterSessionNotification(HANDLE wnd) { return TRUE; }
+WINAPI(WTSUnRegisterSessionNotification)
