From 3f51934cc08cedd77e4525b19b80ddf8ee7c4255 Mon Sep 17 00:00:00 2001
From: Lars Grahmann <lars@grahmann.family>
Date: Thu, 29 Oct 2026 14:46:53 +0100
Subject: [PATCH 5/5] Keep sensor deletion out of the host's record clear

With the driver's own storage, wiping the record list also deleted the
templates on the sensor. The plugin clears the host's list every time it
hands the host back on close, so each release erased every enrolled
finger. Deleting on the sensor is its own call now, made for a deleted
print, the CLI wipe and a new CLEAR_STORAGE message for clear_storage.
---
 cli/src/cli.c                          |  1 +
 libfprint-tod/src/data.c               |  2 +-
 libtudor/inc/tudor/tudor.h             |  2 ++
 libtudor/src/tudor/storage.c           | 25 ++++++++++++++++---------
 tudor-host/inc/tudor/libfprint-proto.h |  5 ++++-
 tudor-host/src/handler.c               | 16 +++++++++++++++-
 6 files changed, 39 insertions(+), 12 deletions(-)

diff --git a/cli/src/cli.c b/cli/src/cli.c
index 0edc8ef..bf4f280 100644
--- a/cli/src/cli.c
+++ b/cli/src/cli.c
@@ -211,6 +211,7 @@ void cli_main_loop(struct tudor_device *device) {
 
                 //Wipe records
                 int num_wiped = tudor_wipe_records(device, all_guids ? NULL: &guid, finger);
+                tudor_delete_sensor_records(device, all_guids ? NULL : &guid, finger);
                 printf("Succesfully wiped %d enrolled finger(s)\n", num_wiped);
             } goto cmdend;
             case 's': abort_cmd_loop = true; goto cmdend;
diff --git a/libfprint-tod/src/data.c b/libfprint-tod/src/data.c
index 7eb97f5..2095272 100644
--- a/libfprint-tod/src/data.c
+++ b/libfprint-tod/src/data.c
@@ -327,6 +327,6 @@ void fpi_device_clear_storage(FpDevice *dev) {
 
     //Tell the driver host
     tdev->send_msg->size = sizeof(enum ipc_msg_type);
-    tdev->send_msg->type = IPC_MSG_CLEAR_RECORDS;
+    tdev->send_msg->type = IPC_MSG_CLEAR_STORAGE;
     send_acked_ipc_msg(tdev, tdev->send_msg, clear_storage_acked_cb, NULL);
 }
\ No newline at end of file
