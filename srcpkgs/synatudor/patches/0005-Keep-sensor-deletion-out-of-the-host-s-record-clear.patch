diff --git a/libtudor/src/tudor/storage.c b/libtudor/src/tudor/storage.c
index 75cf3c9..bab3a7a 100644
--- a/libtudor/src/tudor/storage.c
+++ b/libtudor/src/tudor/storage.c
@@ -1,16 +1,23 @@
 #include "internal.h"
 
-int tudor_wipe_records(struct tudor_device *device, RECGUID *guid, enum tudor_finger finger) {
-    //With the driver's own storage the templates live on the sensor, delete them there too
-    if(tudor_vendor_storage) {
-        winmodule_set_cur(&tudor_adapter_dll->module);
-        WINBIO_IDENTITY ident = { .Type = guid ? WINBIO_ID_TYPE_GUID : WINBIO_ID_TYPE_WILDCARD };
-        if(guid) ident.TemplateGuid = *(GUID*) guid;
-        else ident.Null = WINBIO_IDENTITY_WILDCARD;
-        HRESULT hres = tudor_storage_adapter->DeleteRecord(device->pipeline, &ident, (UCHAR) finger);
-        log_info("Deleted sensor records: 0x%x", hres);
+bool tudor_delete_sensor_records(struct tudor_device *device, RECGUID *guid, enum tudor_finger finger) {
+    //Only the driver's own storage keeps templates on the sensor, ours are
+    //all in the record list
+    if(!tudor_vendor_storage) return true;
+
+    winmodule_set_cur(&tudor_adapter_dll->module);
+    WINBIO_IDENTITY ident = { .Type = guid ? WINBIO_ID_TYPE_GUID : WINBIO_ID_TYPE_WILDCARD };
+    if(guid) ident.TemplateGuid = *(GUID*) guid;
+    else ident.Null = WINBIO_IDENTITY_WILDCARD;
+    HRESULT hres = tudor_storage_adapter->DeleteRecord(device->pipeline, &ident, (UCHAR) finger);
+    if(hres != ERROR_SUCCESS && hres != WINBIO_E_DATABASE_NO_RESULTS) {
+        log_error("Error deleting sensor records: 0x%x!", hres);
+        return false;
     }
+    return true;
+}
 
+int tudor_wipe_records(struct tudor_device *device, RECGUID *guid, enum tudor_finger finger) {
