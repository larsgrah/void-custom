post_install() {
	# no systemd here, ydotoold gets started from the session instead
	rm -rf ${DESTDIR}/usr/lib/systemd
	vinstall ${FILESDIR}/99-uinput.rules 644 usr/lib/udev/rules.d
	vlicense LICENSE
}
