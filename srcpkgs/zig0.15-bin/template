# Template file for 'zig0.15-bin'
pkgname=zig0.15-bin
version=0.15.2
revision=1
archs="x86_64"
short_desc="Zig compiler toolchain 0.15 (upstream binary build)"
maintainer="larsgrah <void@lars.earth>"
license="MIT"
homepage="https://ziglang.org"
nostrip=yes

# ghostty 1.3 pins minimum_zig_version = 0.15.2 and zig breaks between
# minor releases, so it cannot use void's 0.13 or the 0.16 in zig-bin here.
# this installs under its own prefix so all three can coexist.
#
# x86_64 only on purpose. the aarch64 checksum is not verified here and a
# made up one would fail at fetch time instead of build time.
distfiles="https://ziglang.org/download/${version}/zig-x86_64-linux-${version}.tar.xz"
checksum="02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239"
wrksrc="zig-x86_64-linux-${version}"

if [ "${XBPS_TARGET_LIBC}" = "musl" ]; then
    broken="upstream Zig binary needs glibc"
fi

do_install() {
    # zig locates its stdlib relative to the real binary, so the whole
    # toolchain goes in one prefix and /usr/bin gets a symlink into it.
    # a copy in /usr/bin would make zig look for /usr/lib/zig and find
    # whichever version zig-bin installed
    vmkdir usr/lib/zig0.15
    vcopy zig usr/lib/zig0.15
    vcopy lib usr/lib/zig0.15
    vmkdir usr/bin
    ln -s ../lib/zig0.15/zig "${DESTDIR}/usr/bin/zig0.15"
    vlicense LICENSE
}
